---
/**
 * Question page: the question as the H1, a 40 to 60 word direct answer,
 * Andy Taleb byline with published and updated dates, the body, "How we
 * worked this out", sources, a short FAQ (FAQPage schema) and a Discovery
 * Audit call to action. Use it from a guide with `layout: answer`; the
 * guides schema refuses to index one until its TODOs are filled.
 */
import type { ComponentProps } from 'astro/types';
import LongformLayout from './LongformLayout.astro';

type Props = Omit<ComponentProps<typeof LongformLayout>, 'variant' | 'schemaType'>;
const props = Astro.props;
---

<LongformLayout {...props} schemaType="Article" variant="answer">
  <slot />
</LongformLayout>
