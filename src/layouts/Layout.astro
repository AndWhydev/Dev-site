---
import '../styles/global.css';
import PremiumEffects from '../components/PremiumEffects.astro';
import { ORG_ID, FOUNDER_ID, FOUNDER_LINKEDIN, SAME_AS, PHONE_E164, ADDRESS, GOOGLE_TAG_ID } from '../config/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noCanonical?: boolean;
  noindex?: boolean;
  /** Custom robots meta, e.g. 'noindex, follow'. Overrides noindex. */
  robots?: string;
  /** Additional JSON-LD objects to emit alongside the Organization schema (Service, FAQPage, BreadcrumbList, etc.) */
  extraSchema?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/og-image.jpg',
  canonical,
  noCanonical = false,
  noindex = false,
  robots,
  extraSchema = [],
} = Astro.props;

const siteUrl = 'https://www.awlabs.com.au';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;

// Canonical brand definition, entity-locking sentence used site-wide for AI search (GEO).
// Keep this string identical wherever it appears across the site.
export const BRAND_DEFINITION =
  'AWLabs is a Sydney based AI and software development company for growing businesses and enterprise. Sister company to All Webbed Up, a separate websites and marketing company.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'AWLabs',
  legalName: 'AW Labs Pty Ltd',
  alternateName: ['AWL', 'AW Labs', 'AWLabs', 'All Webbed Labs'],
  taxID: 'ABN 32 698 684 105',
  foundingDate: '2026',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  description: BRAND_DEFINITION,
  email: 'admin@awlabs.com.au',
  telephone: PHONE_E164,
  founder: {
    '@type': 'Person',
    '@id': FOUNDER_ID,
    name: 'Andy Taleb',
    jobTitle: 'Director',
    url: `${siteUrl}/team/andy-taleb`,
    sameAs: [FOUNDER_LINKEDIN],
  },
  areaServed: { '@type': 'Country', name: 'Australia' },
  knowsAbout: [
    'Custom software development',
    'Enterprise application development',
    'Artificial intelligence integration',
    'Large language model integration',
    'Retrieval-augmented generation',
    'Cloud infrastructure and DevOps',
    'Cybersecurity',
    'Blockchain and smart contract development',
    'Data analytics',
    'Workflow automation',
    'AI agents',
    'Model Context Protocol',
    'Data residency and sovereignty',
  ],
  address: { '@type': 'PostalAddress', ...ADDRESS },
  // Only profiles that ARE AWLabs (see src/config/site.ts). Personal profiles
  // belong on the founder Person node; All Webbed Up is a separate business.
  sameAs: SAME_AS,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonicalUrl} />}
    {robots ? <meta name="robots" content={robots} /> : noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:site_name" content="AWLabs" />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <!-- Fonts, non-render-blocking. Preconnect warms TLS to the font CDNs,
         the print-media trick lets the browser fetch the stylesheet without
         delaying first paint, and `display=swap` shows fallback text until
         the webfont arrives. Weights are subset to the ones actually used
         site-wide (Sora 300-800, DM Sans 300-700). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" />
    </noscript>

    <!-- Theme color -->
    <meta name="theme-color" content="#0a0f0e" />
    <meta name="msapplication-TileColor" content="#0a0f0e" />

    {GOOGLE_TAG_ID && (
      <>
        <!-- Google tag (set GOOGLE_TAG_ID in src/config/site.ts) -->
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_TAG_ID}`}></script>
        <script is:inline define:vars={{ id: GOOGLE_TAG_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {extraSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {/* No ClientRouter: its in-page navigation left bundled scripts (the
        enquiry form, FAQ accordions) unbound on swapped pages and skipped
        Google page views. Full page loads, with a CSS cross-page fade in
        global.css. */}

    {/* Suppress benign InvalidStateError that the View Transitions API throws
        when a navigation is superseded by another (fast click, back button,
        link clicked mid-transition). The page still renders correctly, this
        just keeps the console quiet for an error that has no functional
        impact and that Astro itself does not handle internally. */}
    <script is:inline>
      window.addEventListener('unhandledrejection', (e) => {
        const r = e.reason;
        if (r && r.name === 'InvalidStateError' &&
            typeof r.message === 'string' &&
            r.message.includes('Transition was aborted')) {
          e.preventDefault();
        }
      });
    </script>
  </head>

  <body>
    {/* Scroll reveals start hidden and need JS to show; without JS show them.
        Kept in the body: a style block inside the head noscript made Astro
        end the head early, pushing JSON-LD and the Google tag out of it. */}
    <noscript><style>#page-loader { display: none !important; } .reveal, .reveal-left, .reveal-right, .reveal-scale, [data-anim] { opacity: 1 !important; transform: none !important; }</style></noscript>
    <style is:global>
      /* View transition animations */
      ::view-transition-old(root) {
        animation: 220ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
      }
      ::view-transition-new(root) {
        animation: 280ms cubic-bezier(0, 0, 0.2, 1) both vt-fade-in;
      }
      @keyframes vt-fade-out {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-8px); }
      }
      @keyframes vt-fade-in {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }
    </style>

    <PremiumEffects />

    <!-- Loading screen -->
    <div id="page-loader">
      <div class="loader-inner">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="48" height="48" rx="12" fill="#0d9373"/>
          <path d="M12 36L24 12L36 36" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15.5 28.5H32.5" stroke="white" stroke-width="3.5" stroke-linecap="round"/>
        </svg>
        <span>AWLabs</span>
        <div class="loader-bar"><div class="loader-fill"></div></div>
      </div>
    </div>

    <slot />

    <style>
      #page-loader {
        position: fixed;
        inset: 0;
        background: #0a0f0e;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        transition: opacity 0.5s ease, visibility 0.5s ease;
        /* Failsafe: fades out on its own even if the page script never runs. */
        animation: awl-loader-out 0.5s ease 2s forwards;
      }
      #page-loader.hidden {
        opacity: 0;
        visibility: hidden;
      }
      @keyframes awl-loader-out { to { opacity: 0; visibility: hidden; } }
      .loader-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }
      .loader-inner svg {
        animation: loader-pulse 1s ease-in-out infinite;
      }
      .loader-inner span {
        font-family: 'Sora', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: #8aa09a;
        text-transform: uppercase;
      }
      .loader-bar {
        width: 200px;
        height: 2px;
        background: #1e2d28;
        border-radius: 2px;
        overflow: hidden;
      }
      .loader-fill {
        width: 100%;
        height: 100%;
        background: #0d9373;
        border-radius: 2px;
        transform: scaleX(0);
        transform-origin: left center;
        animation: loader-fill 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      }
      @keyframes loader-pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
      }
      @keyframes loader-fill {
        from { transform: scaleX(0); }
        to   { transform: scaleX(1); }
      }
    </style>

    <script>
      // Page loader close logic.
      //
      // The loader is rendered into the layout, so it appears on every page
      // including pages swapped in by Astro's ClientRouter. Two distinct paths
      // need to close it:
      //
      //   1. Initial hard load: wait for window.load, then add .hidden (with a
      //      600ms delay so the loader animation doesn't snap shut mid-frame).
      //   2. ClientRouter swap: window.load never refires after a transition,
      //      so the layout's freshly-painted loader would stay visible forever.
      //      The astro:after-swap listener kills it on every navigation.
      //
      // Returning sessions skip the splash entirely (display:none, no animation).
      const noAnim = /[?&]noanim=1\b/.test(location.search);
      // sessionStorage throws when cookies are blocked; treat that as a
      // returning visit so the loader is skipped rather than stuck.
      let isFirstVisit = false;
      try {
        isFirstVisit = !sessionStorage.getItem('awl_visited');
        sessionStorage.setItem('awl_visited', '1');
      } catch {}

      // Screenshot/debugging escape hatch: when ?noanim=1 is on the URL, also
      // shrink any 100vh hero blocks so a full-page capture can show what is
      // below the fold without the hero swallowing the viewport.
      if (noAnim) {
        const s = document.createElement('style');
        s.textContent = '.awl-hero,.hero-section,[class*="hero"]{min-height:auto!important}#page-loader{display:none!important}';
        document.head.appendChild(s);
      }

      if (noAnim || !isFirstVisit) {
        const loader = document.getElementById('page-loader');
        if (loader) loader.style.display = 'none';
      } else {
        // Close once the page is parsed (this module script runs then), not
        // after every image and iframe has loaded: first visits are ad clicks.
        setTimeout(() => {
          const loader = document.getElementById('page-loader');
          if (loader) loader.classList.add('hidden');
        }, 400);
      }

      // ClientRouter navigations swap a fresh layout (including a fresh
      // loader DOM node) into the page. window.load won't fire again, so
      // hide the new node immediately on every swap.
      document.addEventListener('astro:after-swap', () => {
        const loader = document.getElementById('page-loader');
        if (loader) loader.style.display = 'none';
      });

      // Scroll reveal, runs on initial load and after every view transition.
      // Honours `?noanim=1` query param: forces every reveal element visible
      // immediately and skips the observer. Used for headless screenshot runs
      // and visual debugging where animations fight the capture.
      function initReveal() {
        const forceShow = /[?&]noanim=1\b/.test(location.search);
        if (forceShow) {
          document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach((el) => {
            el.classList.add('visible');
          });
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 }
        );
        document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach((el) => {
          observer.observe(el);
        });
      }

      initReveal();
      document.addEventListener('astro:after-swap', initReveal);

      // Centre a short last row in card grids, so a lone card never sits
      // stuck to the left. Only touches grids of equal-width columns whose
      // children are all the same kind of card with automatic placement.
      // Uses `left` (position: relative) so it never fights reveal transforms.
      function centreOrphans() {
        document.querySelectorAll('main *').forEach((grid) => {
          const cs = getComputedStyle(grid);
          if (cs.display !== 'grid' || grid.closest('form, table, [data-no-centre]')) return;
          const items = Array.from(grid.children).filter((c) => {
            const s = getComputedStyle(c);
            return s.display !== 'none' && s.position !== 'absolute' && s.position !== 'fixed';
          });
          items.forEach((c) => { if (c.dataset.orphan) { c.style.left = ''; delete c.dataset.orphan; } });
          const tracks = cs.gridTemplateColumns.split(' ').map(parseFloat).filter((n) => !isNaN(n));
          const cols = tracks.length;
          if (cols < 2 || items.length <= cols) return;
          if (tracks.some((t) => Math.abs(t - tracks[0]) > 1)) return;
          const kind = items[0].tagName + '.' + (items[0].classList[0] || '');
          if (!items.every((c) => c.tagName + '.' + (c.classList[0] || '') === kind)) return;
          if (items.some((c) => { const s = getComputedStyle(c); return s.gridColumnStart !== 'auto' || s.gridColumnEnd !== 'auto' || s.gridRowStart !== 'auto'; })) return;
          const rest = items.length % cols;
          if (!rest) return;
          const gap = parseFloat(cs.columnGap) || 0;
          const shift = ((cols - rest) * (tracks[0] + gap)) / 2;
          items.slice(items.length - rest).forEach((c) => {
            if (getComputedStyle(c).position === 'static') c.style.position = 'relative';
            c.style.left = shift + 'px';
            c.dataset.orphan = '1';
          });
        });
      }
      let orphanTimer;
      const scheduleOrphans = () => { clearTimeout(orphanTimer); orphanTimer = setTimeout(centreOrphans, 120); };
      if (document.readyState === 'complete') centreOrphans(); else window.addEventListener('load', centreOrphans);
      window.addEventListener('resize', scheduleOrphans);
      document.addEventListener('astro:after-swap', centreOrphans);
    </script>
  </body>
</html>
