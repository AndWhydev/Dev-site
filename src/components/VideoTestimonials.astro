---
import transcripts from '../data/testimonial-transcripts.json';
/**
 * VideoTestimonials - client video stories on the homepage.
 * Each card shows a poster image; the video only loads when the visitor
 * presses play, so the homepage stays fast. Anchor: #testimonials
 * (the hero's "Watch client stories" button scrolls here).
 * Only publish a video once the client has agreed in writing.
 *
 * Card copy rules: every role, quote and outcome must come from the
 * person's own words in src/data/testimonial-transcripts.json (or the
 * video itself). Quotes are their words, lightly trimmed, never reworded.
 *
 * Layout: every media frame is the same 4:5 shape so cards line up.
 * Portrait videos fill the frame; landscape videos sit uncropped on a
 * blurred copy of their own poster, so no faces get cut off.
 * Phone: a swipeable row with the next card peeking. Desktop: 4 col grid.
 */

interface Story {
  name: string;
  role: string; // who they are, from the transcript
  quote: string; // one sentence, their words
  outcome: string; // what was built or fixed, from the transcript
  file: string; // /videos/testimonials/<file>.mp4 and .webp poster
  portrait: boolean;
}

const stories: Story[] = [
  {
    name: 'Britney',
    role: 'Personal trainer',
    quote: "I don't actually have to manually go in and process any payments.",
    outcome: 'A website that takes client payments automatically',
    file: 'britney',
    portrait: true,
  },
  {
    name: 'Dave',
    role: 'Runs his own construction company',
    quote: "I'd written the whole thing off in my head and Andy and the team brought it back to life for me.",
    outcome: 'Rescued a bookings and invoicing platform another provider left in a mess',
    file: 'dave',
    portrait: true,
  },
  {
    name: 'Kawkab',
    role: 'Supplies professional hair and beauty products across Australia',
    quote: 'They listened to what our business needed and explained everything to us clearly.',
    outcome: 'Rebuilt an outdated website so products and online orders are easier to manage',
    file: 'kawkab',
    portrait: true,
  },
  {
    name: 'Nat',
    role: 'Runs an online health and fitness coaching business',
    quote: 'They found a security hole, fixed it and put monitoring in place to keep an eye on things moving forward.',
    outcome: 'Tested their systems like a real attacker, closed the gap and added monitoring',
    file: 'nat',
    portrait: false,
  },
  {
    name: 'Scott',
    role: 'Runs an online marketplace',
    quote: 'That one issue could have brought the whole marketplace to a halt.',
    outcome: 'Audited the payments setup before launch and restructured how the money moves',
    file: 'img6966',
    portrait: false,
  },
  {
    name: 'Helen',
    role: 'Hairdresser on the Central Coast',
    quote: 'Spending way less time on admin and much more time with my clients.',
    outcome: 'One place for client history and previous appointments',
    file: 'option2',
    portrait: true,
  },
  {
    name: 'Ebony',
    role: 'Founder of an early childhood compliance platform',
    quote: 'They treated my project like it was their own.',
    outcome: 'An MVP to validate the idea and seek investment, now a working product',
    file: 'ebony',
    portrait: false,
  },
  {
    name: 'Michael',
    role: 'Supplies and installs commercial flooring',
    quote: "We've gone from a Sydney business to quoting and winning flooring jobs all around Australia.",
    outcome: 'A quoting system built around how they price jobs, usable from anywhere',
    file: 'whatsapp',
    portrait: true,
  },
];

const SITE = 'https://www.awlabs.com.au';
const tx = transcripts as Record<string, { transcript: string | null; duration: number }>;
const secs = (s: Story) => tx[s.file]?.duration ?? 60;
const iso = (n: number) => `PT${Math.floor(n / 60)}M${Math.round(n % 60)}S`;
const clock = (n: number) => `${Math.floor(n / 60)}:${String(Math.round(n % 60)).padStart(2, '0')}`;
const spoken = (n: number) => {
  const m = Math.floor(n / 60);
  const r = Math.round(n % 60);
  return [m ? `${m} minute${m > 1 ? 's' : ''}` : '', r ? `${r} seconds` : ''].filter(Boolean).join(' ');
};
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AWLabs client video testimonials',
  itemListElement: stories.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'VideoObject',
      name: `${s.name}: ${s.role}`,
      description: `“${s.quote}” ${s.outcome}.`,
      thumbnailUrl: `${SITE}/videos/testimonials/${s.file}.webp`,
      contentUrl: `${SITE}/videos/testimonials/${s.file}.mp4`,
      uploadDate: '2026-11-04',
      duration: iso(secs(s)),
      inLanguage: 'en-AU',
      ...(tx[s.file]?.transcript ? { transcript: tx[s.file].transcript } : {}),
      publisher: { '@id': `${SITE}/#organization` },
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

<section class="vt-section" id="testimonials" aria-labelledby="vt-heading">
  <div class="vt-inner">
    <div class="vt-header reveal">
      <span class="section-label">Client stories</span>
      <h2 id="vt-heading" class="section-heading">Hear it from the people we build with.</h2>
      <p class="section-subheading">Founders and business owners talking about their build, in their own words.</p>
    </div>

    <ul class="vt-track" role="list" aria-label="Client video testimonials">
      {stories.map((s) => (
        <li class="vt-card">
          <div class={`vt-frame ${s.portrait ? 'is-portrait' : 'is-landscape'}`}>
            <img
              class="vt-backdrop"
              src={`/videos/testimonials/${s.file}.webp`}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <img
              class="vt-poster"
              src={`/videos/testimonials/${s.file}.webp`}
              alt=""
              loading="lazy"
              decoding="async"
              width={s.portrait ? 540 : 960}
              height={s.portrait ? 960 : 540}
            />
            <button
              type="button"
              class="vt-play"
              data-src={`/videos/testimonials/${s.file}.mp4`}
              data-captions={tx[s.file]?.transcript ? `/videos/testimonials/${s.file}.vtt` : ''}
              aria-label={`Play ${s.name}'s video, ${spoken(secs(s))}, with sound`}
            >
              <span class="vt-play-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <span class="vt-duration" aria-hidden="true">{clock(secs(s))}</span>
            </button>
          </div>
          <div class="vt-body">
            <p class="vt-who">
              <strong>{s.name}</strong>
              <span>{s.role}</span>
            </p>
            <blockquote class="vt-quote"><p>{s.quote}</p></blockquote>
            <p class="vt-outcome"><span class="vt-outcome-label">The work</span>{s.outcome}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="vt-nav" aria-hidden="true">
      <button type="button" class="vt-arrow" data-dir="-1" tabindex="-1" aria-label="Previous story">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <span class="vt-count"><span class="vt-count-now">1</span> / {stories.length}</span>
      <button type="button" class="vt-arrow" data-dir="1" tabindex="-1" aria-label="Next story">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .vt-section {
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    scroll-margin-top: 80px;
  }
  .vt-inner { max-width: 1216px; margin: 0 auto; }
  .vt-header { text-align: center; max-width: 720px; margin: 0 auto 3rem; }
  .vt-header .section-subheading { margin-left: auto; margin-right: auto; }

  .vt-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
  }

  .vt-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--color-surface, #0f1614);
    border: 1px solid var(--color-border, #1e2d28);
    border-radius: 18px;
    overflow: hidden;
  }

  /* Media frame: same shape for every card */
  .vt-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #050807;
  }
  .vt-backdrop {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    object-fit: cover;
    filter: blur(22px) brightness(0.45) saturate(1.1);
    transform: scale(1.05);
  }
  .vt-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .is-portrait .vt-poster { object-fit: cover; object-position: 50% 30%; }
  .is-portrait .vt-backdrop { display: none; }
  .is-landscape .vt-poster { object-fit: contain; }

  .vt-frame :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }
  .vt-frame.is-playing .vt-poster,
  .vt-frame.is-playing .vt-play { display: none; }
  /* Show the whole portrait video while playing, on a blurred backdrop */
  .vt-frame.is-playing .vt-backdrop { display: block; }

  .vt-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: linear-gradient(to top, rgba(5, 8, 7, 0.55) 0%, rgba(5, 8, 7, 0) 38%);
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 14px;
    color: #fff;
  }
  .vt-play-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(13, 147, 115, 0.94);
    box-shadow: 0 10px 30px -6px rgba(13, 147, 115, 0.7);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .vt-play-icon svg { margin-left: 3px; }
  .vt-duration {
    font-family: var(--font-body, 'DM Sans', sans-serif);
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(5, 8, 7, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .vt-play:hover .vt-play-icon,
  .vt-play:focus-visible .vt-play-icon { transform: scale(1.08); background: var(--color-primary, #0d9373); }
  .vt-play:focus-visible { outline: 2px solid #10b981; outline-offset: -4px; border-radius: 18px 18px 0 0; }

  /* Text */
  .vt-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.1rem 1.15rem 1.25rem;
    flex: 1;
  }
  .vt-who { margin: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .vt-who strong { color: #fff; font-family: var(--font-heading, 'Sora', sans-serif); font-size: 1.0625rem; font-weight: 600; }
  .vt-who span { color: var(--color-muted, #8aa09a); font-size: 0.875rem; line-height: 1.4; }
  .vt-quote { margin: 0; }
  .vt-quote p {
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .vt-quote p::before { content: '\201C'; }
  .vt-quote p::after { content: '\201D'; }
  .vt-outcome {
    margin: auto 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border, #1e2d28);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .vt-outcome-label {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-primary-light, #10b88a);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vt-nav { display: none; }

  @media (max-width: 1100px) {
    .vt-track { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Tablet and phone: swipeable row, next card peeks in */
  @media (max-width: 900px) {
    .vt-section { padding-left: 0; padding-right: 0; }
    .vt-header { padding: 0 1.5rem; margin-bottom: 2rem; }
    .vt-track {
      display: flex;
      gap: 0.875rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1.5rem;
      padding: 0 1.5rem 0.25rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .vt-track::-webkit-scrollbar { display: none; }
    .vt-card {
      flex: 0 0 clamp(250px, 76vw, 320px);
      scroll-snap-align: start;
    }
    .vt-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.25rem;
    }
    .vt-arrow {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: #fff;
      background: var(--color-surface-2, #141c1a);
      border: 1px solid var(--color-border, #1e2d28);
      cursor: pointer;
    }
    .vt-arrow:disabled { opacity: 0.35; cursor: default; }
    .vt-count {
      min-width: 3.5rem;
      text-align: center;
      color: var(--color-muted, #8aa09a);
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-play-icon { transition: none; }
  }
</style>

<script>
  function initVideoTestimonials() {
    const section = document.getElementById('testimonials');
    if (!section || section.dataset.ready === '1') return;
    section.dataset.ready = '1';
    const track = section.querySelector<HTMLElement>('.vt-track');
    if (!track) return;

    // One video at a time: whenever any testimonial starts, pause the rest
    const pauseOthers = (current?: HTMLVideoElement) => {
      section.querySelectorAll('video').forEach((v) => {
        if (v !== current && !v.paused) v.pause();
      });
    };

    section.querySelectorAll<HTMLButtonElement>('.vt-play').forEach((btn) => {
      btn.addEventListener('click', () => {
        const frame = btn.closest<HTMLElement>('.vt-frame');
        if (!frame) return;
        const video = document.createElement('video');
        video.src = btn.dataset.src || '';
        video.controls = true;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.preload = 'auto';
        video.setAttribute('aria-label', btn.getAttribute('aria-label')?.replace(/^Play /, '') || 'Client video');
        if (btn.dataset.captions) {
          const track = document.createElement('track');
          track.kind = 'captions';
          track.srclang = 'en';
          track.label = 'English';
          track.src = btn.dataset.captions;
          track.default = true;
          video.appendChild(track);
        }
        video.addEventListener('play', () => pauseOthers(video));
        frame.appendChild(video);
        frame.classList.add('is-playing');
        pauseOthers(video);
        video.focus({ preventScroll: true });
        video.play().catch(() => {});
      });
    });

    // Pause a video once it is swiped or scrolled out of view
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.intersectionRatio < 0.35) e.target.querySelector('video')?.pause();
        }),
        { threshold: [0, 0.35] },
      );
      section.querySelectorAll('.vt-frame').forEach((f) => io.observe(f));
    }

    // Phone and tablet carousel: arrows and "1 / 8" counter
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.vt-card'));
    const now = section.querySelector('.vt-count-now');
    const arrows = section.querySelectorAll<HTMLButtonElement>('.vt-arrow');
    const current = () => {
      const left = track.scrollLeft;
      let best = 0;
      cards.forEach((c, i) => {
        if (Math.abs(c.offsetLeft - track.offsetLeft - left) < Math.abs(cards[best].offsetLeft - track.offsetLeft - left)) best = i;
      });
      return best;
    };
    const update = () => {
      const i = current();
      if (now) now.textContent = String(i + 1);
      const end = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      arrows.forEach((a) => {
        a.disabled = a.dataset.dir === '-1' ? track.scrollLeft < 4 : end;
      });
    };
    arrows.forEach((a) =>
      a.addEventListener('click', () => {
        const i = Math.max(0, Math.min(cards.length - 1, current() + Number(a.dataset.dir)));
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollTo({ left: cards[i].offsetLeft - cards[0].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
      }),
    );
    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    }, { passive: true });
    update();
  }
  initVideoTestimonials();
  document.addEventListener('astro:after-swap', initVideoTestimonials);
</script>
