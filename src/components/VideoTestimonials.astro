---
import transcripts from '../data/testimonial-transcripts.json';
/**
 * VideoTestimonials - client video stories on the homepage.
 * Each card shows a poster image; the video only loads when the visitor
 * presses play, so the homepage stays fast. Anchor: #testimonials
 * (the hero's "Watch client stories" button scrolls here).
 * Only publish a video once the client has agreed in writing.
 */

interface Story {
  name: string;
  context: string;
  file: string; // /videos/testimonials/<file>.mp4 and .webp poster
  portrait: boolean;
}

const stories: Story[] = [
  { name: 'Britney', context: 'Founder, fitness', file: 'britney', portrait: true },
  { name: 'Dave', context: 'Founder, construction', file: 'dave', portrait: true },
  { name: 'Kawkab', context: 'Founder, wholesale', file: 'kawkab', portrait: true },
  { name: 'Nat', context: 'Founder, health and fitness', file: 'nat', portrait: false },
  { name: 'Scott', context: 'Founder, online marketplace', file: 'img6966', portrait: false },
  { name: 'Helen', context: 'Founder, hairdressing', file: 'option2', portrait: true },
  { name: 'Ebony', context: 'Founder, childcare', file: 'ebony', portrait: false },
  { name: 'Michael', context: 'Founder, flooring', file: 'whatsapp', portrait: true },
];

const SITE = 'https://www.awlabs.com.au';
const iso = (secs: number) => `PT${Math.floor(secs / 60)}M${Math.round(secs % 60)}S`;
const tx = transcripts as Record<string, { transcript: string | null; duration: number }>;
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AWLabs client video testimonials',
  itemListElement: stories.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'VideoObject',
      name: `${s.name} on working with AWLabs`,
      description: `${s.name} (${s.context.replace('Founder, ', 'founder, ')}) talks about working with Andy and the AWLabs team.`,
      thumbnailUrl: `${SITE}/videos/testimonials/${s.file}.webp`,
      contentUrl: `${SITE}/videos/testimonials/${s.file}.mp4`,
      uploadDate: '2026-11-04',
      duration: iso(tx[s.file]?.duration ?? 60),
      inLanguage: 'en-AU',
      ...(tx[s.file]?.transcript ? { transcript: tx[s.file].transcript } : {}),
      publisher: { '@id': `${SITE}/#organization` },
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

<section class="vt-section" id="testimonials" aria-labelledby="vt-heading">
  <div class="vt-inner">
    <div class="vt-header reveal">
      <span class="section-label">Client stories</span>
      <h2 id="vt-heading" class="section-heading">Hear it from the people we build with.</h2>
      <p class="section-subheading">Founders and business owners talking about their build, in their own words.</p>
    </div>

    <div class="vt-grid">
      {stories.map((s, i) => (
        <figure class={`vt-card reveal stagger-${Math.min(i + 1, 6)}`}>
          <button
            type="button"
            class="vt-media"
            data-src={`/videos/testimonials/${s.file}.mp4`}
            data-portrait={s.portrait ? '1' : '0'}
            data-captions={tx[s.file]?.transcript ? `/videos/testimonials/${s.file}.vtt` : ''}
            aria-label={`Play video: ${s.name}, ${s.context}`}
          >
            <img
              src={`/videos/testimonials/${s.file}.webp`}
              alt={`${s.name}, ${s.context}`}
              loading="lazy"
              decoding="async"
              width="720"
              height={s.portrait ? 1280 : 405}
            />
            <span class="vt-play" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
          <figcaption>
            <strong>{s.name}</strong>
            <span>{s.context}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .vt-section {
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    scroll-margin-top: 80px;
  }
  .vt-inner { max-width: 1216px; margin: 0 auto; }
  .vt-header { text-align: center; max-width: 720px; margin: 0 auto 3rem; }
  .vt-header .section-subheading { margin-left: auto; margin-right: auto; }

  .vt-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .vt-card { margin: 0; display: flex; flex-direction: column; gap: 0.85rem; }

  .vt-media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 14;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: #0f1614;
    cursor: pointer;
  }
  .vt-media img,
  .vt-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .vt-media video { background: #000; }
  .vt-media.is-playing video { object-fit: contain; }

  .vt-play {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(13, 147, 115, 0.92);
    box-shadow: 0 10px 30px -6px rgba(13, 147, 115, 0.7);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .vt-play svg { margin-left: 3px; }
  .vt-media:hover .vt-play,
  .vt-media:focus-visible .vt-play { transform: scale(1.08); background: #0d9373; }
  .vt-media:focus-visible { outline: 2px solid #10b981; outline-offset: 3px; }

  .vt-card figcaption { display: flex; flex-direction: column; gap: 0.2rem; }
  .vt-card figcaption strong { color: #fff; font-family: 'Sora', sans-serif; font-size: 1rem; }
  .vt-card figcaption span { color: rgba(255, 255, 255, 0.6); font-size: 0.875rem; }

  @media (max-width: 1100px) {
    .vt-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .vt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .vt-grid { grid-template-columns: 1fr; }
    .vt-header { margin-bottom: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vt-play { transition: none; }
  }
</style>

<script>
  function initVideoTestimonials() {
    document.querySelectorAll<HTMLButtonElement>('.vt-media').forEach((btn) => {
      if (btn.dataset.ready === '1') return;
      btn.dataset.ready = '1';
      btn.addEventListener('click', () => {
        // Pause any other playing testimonial
        document.querySelectorAll<HTMLVideoElement>('.vt-media video').forEach((v) => v.pause());
        // Swap the button for a plain wrapper so the native video controls work
        const wrap = document.createElement('div');
        wrap.className = 'vt-media is-playing';
        const video = document.createElement('video');
        video.src = btn.dataset.src || '';
        video.controls = true;
        video.playsInline = true;
        video.autoplay = true;
        video.preload = 'auto';
        video.crossOrigin = 'anonymous';
        if (btn.dataset.captions) {
          const track = document.createElement('track');
          track.kind = 'captions';
          track.srclang = 'en';
          track.label = 'English';
          track.src = btn.dataset.captions;
          track.default = true;
          video.appendChild(track);
        }
        wrap.appendChild(video);
        btn.replaceWith(wrap);
        video.focus();
        video.play().catch(() => {});
      });
    });
  }
  initVideoTestimonials();
  document.addEventListener('astro:after-swap', initVideoTestimonials);
</script>
