---
/**
 * "At a glance" fact block: one plain text paragraph that states who we are,
 * how an engagement runs and how to reach us. Visible on the page so search
 * engines and AI assistants can quote it verbatim. The text lives in
 * src/lib/facts.ts, shared with /llms.txt and /llms-full.txt.
 *
 * Props:
 *   disambiguation  adds the "not affiliated with" sentence (used on /about)
 *   class           extra class for placement by the parent
 */
interface Props {
  disambiguation?: boolean;
  class?: string;
}
import { FACT_TEXT } from '../lib/facts';

const { disambiguation = false, class: extraClass = '' } = Astro.props;


---

<aside class={`fact-block ${extraClass}`} aria-labelledby="fact-block-heading">
  <div class="fact-block-head">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <h2 id="fact-block-heading" class="fact-block-label">At a glance</h2>
  </div>
  <p class="fact-block-text">{FACT_TEXT}</p>
  {disambiguation && (
    <p class="fact-block-note">AWLabs in Sydney is not affiliated with AWLabs of Belgium or Wawlabs.</p>
  )}
</aside>

<style>
  .fact-block {
    position: relative;
    background: #0a0f0e;
    border: 1px solid #1e2d28;
    border-radius: 20px;
    padding: 2rem 2.25rem;
    overflow: hidden;
  }
  .fact-block::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2rem;
    bottom: 2rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, #0d9373 0%, rgba(13,147,115,0) 100%);
  }
  .fact-block-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #0d9373;
    margin-bottom: 0.875rem;
  }
  .fact-block-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0d9373;
    margin: 0;
  }
  .fact-block-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #a9bdb6;
    margin: 0;
  }
  .fact-block-note {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #6f877e;
    margin: 1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid #1e2d28;
  }
  @media (max-width: 640px) {
    .fact-block { padding: 1.5rem 1.375rem; border-radius: 16px; }
    .fact-block::before { top: 1.5rem; bottom: 1.5rem; }
  }
</style>
