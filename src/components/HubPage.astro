---
/** Listing page for a group of long-form pages (guides, solutions, locations). */
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CTABanner from './CTABanner.astro';

interface Item { title: string; href: string; description: string; updated?: Date }
interface Group { id: string; label: string; intro?: string; items: Item[] }

interface Props {
  metaTitle: string;
  metaDescription: string;
  eyebrow: string;
  title: string;
  intro: string;
  groups: Group[];
  crumbTitle: string;
}

const { metaTitle, metaDescription, eyebrow, title, intro, groups, crumbTitle } = Astro.props;
const siteUrl = 'https://www.awlabs.com.au';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const all = groups.flatMap((g) => g.items);

const extraSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description: metaDescription,
    url: pageUrl,
    publisher: { '@id': `${siteUrl}/#organization` },
    hasPart: all.map((i) => ({ '@type': 'WebPage', name: i.title, url: new URL(i.href, siteUrl).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: crumbTitle, item: pageUrl },
    ],
  },
];
---

<Layout title={metaTitle} description={metaDescription} extraSchema={extraSchema}>
  <Header />
  <main class="hub">
    <header class="hub-hero">
      <div class="hub-wrap">
        <nav class="hub-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">{crumbTitle}</span></nav>
        <span class="section-label">{eyebrow}</span>
        <h1 class="hub-title">{title}</h1>
        <p class="hub-intro">{intro}</p>
        {groups.length > 1 && (
          <nav class="hub-jump" aria-label="Sections">
            {groups.map((g) => <a href={`#${g.id}`}>{g.label}</a>)}
          </nav>
        )}
      </div>
    </header>

    <div class="hub-wrap hub-body">
      {groups.map((g) => (
        <section class="hub-group" id={g.id} aria-labelledby={`${g.id}-h`}>
          <h2 id={`${g.id}-h`} class="hub-group-title">{g.label}</h2>
          {g.intro && <p class="hub-group-intro">{g.intro}</p>}
          <ul class="hub-list">
            {g.items.map((i) => (
              <li>
                <a href={i.href} class="hub-card">
                  <span class="hub-card-title">{i.title}</span>
                  <span class="hub-card-desc">{i.description}</span>
                  <span class="hub-card-more" aria-hidden="true">Read &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  .hub { background: #0a0f0e; color: #fff; }
  .hub-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  .hub-hero { padding: 9rem 0 3rem; border-bottom: 1px solid #1a2620; background: radial-gradient(ellipse 60% 80% at 20% 0%, rgba(13,147,115,0.10), transparent 70%); }
  .hub-crumbs { display: flex; gap: 0.5rem; font-size: 0.8125rem; color: #718b81; margin-bottom: 1.5rem; }
  .hub-crumbs a { color: #718b81; text-decoration: none; }
  .hub-crumbs a:hover { color: #0d9373; }
  .hub-title { font-family: 'Sora', sans-serif; font-size: clamp(2rem, 4.6vw, 3.25rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.025em; margin: 0.75rem 0 1.25rem; max-width: 22ch; }
  .hub-intro { font-size: 1.125rem; line-height: 1.7; color: #b4c4be; max-width: 720px; margin: 0; }
  .hub-jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .hub-jump a { padding: 0.5rem 1rem; border: 1px solid #1f2e28; border-radius: 999px; font-size: 0.875rem; color: #d5e0dc; text-decoration: none; background: #0f1614; }
  .hub-jump a:hover { border-color: #0d9373; color: #fff; }
  .hub-body { padding-top: 1rem; padding-bottom: 5rem; }
  .hub-group { padding-top: 3.5rem; scroll-margin-top: 90px; }
  .hub-group-title { font-family: 'Sora', sans-serif; font-size: clamp(1.4rem, 2.6vw, 1.85rem); font-weight: 700; margin: 0 0 0.6rem; }
  .hub-group-intro { color: #8aa09a; line-height: 1.65; max-width: 720px; margin: 0 0 1.5rem; }
  .hub-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
  .hub-card { display: flex; flex-direction: column; gap: 0.6rem; height: 100%; padding: 1.35rem 1.4rem; border: 1px solid #1a2620; border-radius: 14px; background: #0f1614; text-decoration: none; transition: border-color 0.2s ease, transform 0.2s ease; }
  .hub-card:hover { border-color: #0d9373; transform: translateY(-2px); }
  .hub-card-title { font-family: 'Sora', sans-serif; font-weight: 600; font-size: 1.05rem; color: #fff; line-height: 1.35; }
  .hub-card-desc { font-size: 0.9rem; line-height: 1.6; color: #8aa09a; flex: 1; }
  .hub-card-more { font-size: 0.8125rem; color: #19b58f; font-weight: 600; }
  @media (max-width: 640px) { .hub-hero { padding: 7rem 0 2.5rem; } .hub-list { grid-template-columns: 1fr; } }

  /* Centre a short last row instead of leaving it stuck to the left. */
  .hub-list { display: flex; flex-wrap: wrap; justify-content: center; }
  .hub-list > li { flex: 0 1 300px; min-width: 0; }
  @media (max-width: 640px) { .hub-list > li { flex-basis: 100%; } }
  .hub-group { text-align: center; }
  .hub-group-intro { margin-left: auto; margin-right: auto; }
  .hub-card { text-align: left; }
  @media (max-width: 1024px) {
    .hub-hero .hub-wrap { text-align: center; }
    .hub-crumbs, .hub-jump { justify-content: center; }
    .hub-title, .hub-intro { margin-left: auto; margin-right: auto; }
  }
</style>
