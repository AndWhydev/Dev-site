---
/** Home page links into the guides library (strongest pages first). */
import { getCollection } from 'astro:content';

const featured = [
  'ai-development-cost-australia',
  'rag-knowledge-base-cost',
  'how-to-choose-an-ai-development-company',
  'privacy-act-automated-decision-making',
  'bedrock-vs-azure-openai-vs-vertex-australia',
  'custom-software-development-cost-australia',
];
const all = await getCollection('guides');
const items = featured
  .map((slug) => all.find((g) => g.id === slug))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));
---

{items.length > 0 && (
  <section class="fg" aria-labelledby="fg-heading">
    <div class="fg-inner">
      <div class="fg-head reveal">
        <span class="section-label">Guides</span>
        <h2 id="fg-heading" class="section-heading">Straight answers for Australian buyers</h2>
        <p class="fg-intro">What AI and software projects cost in AUD, how the options compare, and which Australian rules apply. Sourced, dated and written by engineers.</p>
      </div>
      <ul class="fg-list">
        {items.map((g) => (
          <li>
            <a href={`/guides/${g.id}`} class="fg-card">
              <span class="fg-kind">{g.data.eyebrow}</span>
              <span class="fg-title">{g.data.title}</span>
              <span class="fg-desc">{g.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/guides" class="fg-all">All guides &rarr;</a>
    </div>
  </section>
)}

<style>
  .fg { padding: 6rem 0; background: #0a0f0e; border-top: 1px solid #1a2620; }
  .fg-inner { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .fg-head { max-width: 760px; margin-bottom: 2.5rem; }
  .fg-intro { color: #8aa09a; line-height: 1.7; font-size: 1.0625rem; margin: 0.75rem 0 0; }
  .fg-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .fg-card { display: flex; flex-direction: column; gap: 0.55rem; height: 100%; padding: 1.4rem; border: 1px solid #1a2620; border-radius: 14px; background: #0f1614; text-decoration: none; transition: border-color 0.2s ease, transform 0.2s ease; }
  .fg-card:hover { border-color: #0d9373; transform: translateY(-2px); }
  .fg-kind { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: #19b58f; font-weight: 700; }
  .fg-title { font-family: 'Sora', sans-serif; font-weight: 600; font-size: 1.05rem; color: #fff; line-height: 1.35; }
  .fg-desc { font-size: 0.9rem; line-height: 1.6; color: #8aa09a; }
  .fg-all { display: inline-block; margin-top: 1.75rem; color: #19b58f; font-weight: 600; text-decoration: none; }
  .fg-all:hover { text-decoration: underline; }
  @media (max-width: 1024px) { .fg-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .fg { padding: 4rem 0; } .fg-inner { padding: 0 1.25rem; } .fg-list { grid-template-columns: 1fr; } }
</style>
