---
/**
 * Google reviews for AWLabs and for All Webbed Up, our sister agency, shown in
 * two tabs, or stacked with both visible (layout="stacked"). AWU reviews are always labelled as AWU so they are never presented
 * as AWLabs reviews. Data is fetched at build time (src/lib/reviews.ts).
 */
import { getReviews, PLACES } from '../lib/reviews';

const { layout = 'tabs' } = Astro.props as { layout?: 'tabs' | 'stacked' };

const [awlabs, awu] = await Promise.all([getReviews(PLACES.awlabs), getReviews(PLACES.awu)]);

const groups = [
  { id: 'awlabs', tab: 'AWLabs', name: 'AWLabs', note: 'Reviews of AWLabs on Google.', data: awlabs },
  { id: 'awu', tab: 'All Webbed Up', name: 'All Webbed Up', note: 'Reviews of All Webbed Up, our sister agency for websites and marketing, on Google.', data: awu },
].filter((g) => g.data);

function initials(name: string): string {
  return name.split(/\s+/).map((p) => p[0]).filter(Boolean).slice(0, 2).join('').toUpperCase();
}
const tabbed = layout === 'tabs' && groups.length > 1;
const star = 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z';
---

{groups.length > 0 && (
<section class="gr-section" id="reviews" aria-labelledby="gr-heading">
  <div class="gr-inner">
    <div class="gr-header">
      <span class="section-label">Google reviews</span>
      <h2 class="section-heading" id="gr-heading">What clients say on Google.</h2>
    </div>

    {layout === 'tabs' && groups.length > 1 && (
      <div class="gr-tabs" role="tablist" aria-label="Choose business">
        {groups.map((g, i) => (
          <button type="button" role="tab" class="gr-tab" id={`gr-tab-${g.id}`} aria-controls={`gr-panel-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            {g.tab}
            <span class="gr-tab-meta">{g.data!.aggregateRating.toFixed(1)} ★ · {g.data!.totalReviews}</span>
          </button>
        ))}
      </div>
    )}

    {groups.map((g, i) => (
      <div class="gr-panel" id={`gr-panel-${g.id}`} role={tabbed ? 'tabpanel' : undefined} aria-labelledby={tabbed ? `gr-tab-${g.id}` : undefined} hidden={tabbed && i !== 0}>
        {!tabbed && <h3 class="gr-group-title">{g.name}</h3>}
        <div class="gr-summary">
          <div class="gr-stars-lg" aria-hidden="true">
            {[1, 2, 3, 4, 5].map((n) => (
              <svg width="20" height="20" viewBox="0 0 24 24" fill={n <= Math.round(g.data!.aggregateRating) ? '#fbbf24' : 'none'} stroke="#fbbf24" stroke-width="1.5"><path d={star} /></svg>
            ))}
          </div>
          <p class="gr-summary-text">
            <strong>{g.data!.aggregateRating.toFixed(1)}</strong> from {g.data!.totalReviews} reviews on Google. <span class="gr-note">{g.note}</span>
          </p>
        </div>

        <div class="gr-grid">
          {g.data!.reviews.map((r) => (
            <article class="gr-card">
              <div class="gr-top">
                <div class="gr-author">
                  {r.photoUrl
                    ? <img src={r.photoUrl} alt="" class="gr-avatar" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" />
                    : <div class="gr-avatar gr-avatar-fallback" aria-hidden="true">{initials(r.author)}</div>}
                  <div class="gr-author-meta">
                    {r.profileUrl
                      ? <a class="gr-author-name" href={r.profileUrl} target="_blank" rel="noopener nofollow">{r.author}</a>
                      : <span class="gr-author-name">{r.author}</span>}
                    <span class="gr-time">{r.timeDescription}</span>
                  </div>
                </div>
                <svg class="gr-google" width="18" height="18" viewBox="0 0 24 24" role="img" aria-label="Google review">
                  <path fill="#4285f4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34a853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#fbbc04" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#ea4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              </div>
              <div class="gr-stars" role="img" aria-label={`${r.rating} out of 5 stars`}>
                {[1, 2, 3, 4, 5].map((n) => (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill={n <= r.rating ? '#fbbf24' : 'none'} stroke="#fbbf24" stroke-width="1.5" aria-hidden="true"><path d={star} /></svg>
                ))}
              </div>
              <p class="gr-text">{r.text}</p>
            </article>
          ))}
        </div>

        <p class="gr-more">
          <a href={g.data!.reviewsUrl} target="_blank" rel="noopener">{`See all ${g.data!.totalReviews} ${g.name} reviews on Google`}</a>
        </p>
      </div>
    ))}
  </div>
</section>
)}

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.gr-tab'));
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>

<style>
  .gr-section { padding: clamp(3rem, 6vw, 5rem) 1.5rem clamp(4rem, 8vw, 7rem); }
  .gr-inner { max-width: 1216px; margin: 0 auto; }
  .gr-header { text-align: center; max-width: 720px; margin: 0 auto 2rem; }

  .gr-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 auto 2rem;
    flex-wrap: wrap;
  }
  .gr-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Sora', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    border: 1px solid #1e2d28;
    background: transparent;
    color: #8aa69b;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .gr-tab:hover { color: white; border-color: #0d9373; }
  .gr-tab[aria-selected='true'] { background: #0d9373; border-color: #0d9373; color: white; }
  .gr-tab:focus-visible { outline: 2px solid #0d9373; outline-offset: 2px; }
  .gr-tab-meta { font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 0.8rem; opacity: 0.85; }

  .gr-panel[hidden] { display: none; }
  .gr-panel + .gr-panel { margin-top: 4rem; }
  .gr-group-title {
    font-family: 'Sora', sans-serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: white;
    text-align: center;
    margin: 0 0 0.75rem;
  }

  .gr-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    margin-bottom: 2rem;
  }
  .gr-stars-lg { display: inline-flex; gap: 3px; }
  .gr-summary-text { font-family: 'DM Sans', sans-serif; font-size: 0.95rem; color: #8aa09a; margin: 0; max-width: 560px; line-height: 1.6; }
  .gr-summary-text strong { font-family: 'Sora', sans-serif; color: white; font-size: 1.05rem; }
  .gr-note { display: block; font-size: 0.85rem; color: #5f7a70; }

  .gr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .gr-card {
    background: #0f1614;
    border: 1px solid #1e2d28;
    border-radius: 18px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .gr-top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .gr-author { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
  .gr-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: rgba(13, 147, 115, 0.1);
  }
  .gr-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Sora', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: #0d9373;
  }
  .gr-author-meta { display: flex; flex-direction: column; min-width: 0; }
  .gr-author-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: white;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.gr-author-name:hover { text-decoration: underline; }
  .gr-time { font-family: 'DM Sans', sans-serif; font-size: 0.75rem; color: #5f7a70; margin-top: 2px; }
  .gr-google { flex-shrink: 0; }
  .gr-stars { display: flex; gap: 2px; }
  .gr-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.925rem;
    color: #cde0da;
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gr-more { text-align: center; margin: 2rem 0 0; }
  .gr-more a {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #0d9373;
    text-decoration: none;
    border-bottom: 1px solid rgba(13, 147, 115, 0.35);
  }
  .gr-more a:hover { border-color: #0d9373; }

  @media (max-width: 640px) {
    .gr-grid { grid-template-columns: 1fr; }
    .gr-card { padding: 1.25rem; }
  }
</style>
