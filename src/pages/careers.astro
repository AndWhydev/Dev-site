---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';

const openRoles: never[] = [];

const values = [
  { icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`, title: 'Senior led team', desc: 'Senior engineers lead every build and review every change, and they mentor the developers learning alongside them. No micromanagement.' },
  { icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>`, title: 'Competitive pay', desc: 'Competitive salaries for the best engineers. We don\'t lowball, and we don\'t offer equity in place of salary.' },
  { icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`, title: 'Remote first', desc: 'Work from anywhere in Australia. We care about output and quality, not location or hours at a desk.' },
  { icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`, title: 'Real growth', desc: 'Work on genuinely complex problems for growing businesses and enterprise across diverse industries. You\'ll grow faster here than at a company with a single product.' },
  { icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6.5L4.5 19a1.5 1.5 0 001.3 2h12.4a1.5 1.5 0 001.3-2L14 9.5V3"/><path d="M7 15h10"/></svg>`, title: 'R&D time', desc: 'Time set aside to learn, build side projects and explore new technology. We invest in your curiosity.' },
  { icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/><path d="M8 9h8M8 13h5"/></svg>`, title: 'Honest culture', desc: 'We say what we think. Clients hear the truth. Team members give real feedback. No corporate doublespeak.' },
];

const roles = [
  'Senior Frontend Engineer (React / Next.js)',
  'Senior Mobile Engineer (Flutter)',
  'Backend Engineer (Node.js / Python)',
  'AI / ML Engineer',
  'Senior DevOps / Platform Engineer',
  'UI / UX Designer',
  'Technical Project Manager',
  'Solutions Architect',
];
---

<Layout
  title="Careers: Join Our Engineering Team | AWLabs"
  description="Join AWLabs, a Sydney software team where senior engineers lead every build and mentor developers in training. Remote first, with real problems to solve."
>
  <Header />
  <main>

    <section class="careers-hero">
      <div class="careers-inner">
        <div class="reveal">
          <span class="section-label">Careers</span>
          <h1 class="careers-title">
            Build Software<br />
            <span class="gradient-text">That Actually Matters.</span>
          </h1>
          <p class="careers-sub">
            We're a team of engineers, designers and strategists, led by senior engineers, who care deeply about craft, honesty and building things that last.
            If that sounds like you, we'd like to meet you.
          </p>
          <a href="mailto:admin@awlabs.com.au" class="btn-primary">
            Send Us Your CV
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <p class="collect-notice">We use your CV only to consider you for work with us. See our <a href="/privacy">privacy policy</a> for how we store it and how to ask us to delete it.</p>
        </div>
      </div>
    </section>

    <!-- Why work here -->
    <section class="why-section">
      <div class="careers-inner">
        <div class="reveal">
          <span class="section-label">Why AWLabs</span>
          <h2 class="section-heading">What Makes This Different</h2>
        </div>
        <div class="values-grid">
          {values.map((v, i) => (
            <div class={`value-card reveal stagger-${Math.min(i + 1, 6)}`}>
              <div class="vc-emoji" set:html={v.icon} />
              <h3>{v.title}</h3>
              <p>{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Open roles -->
    <section class="roles-section">
      <div class="careers-inner">
        <div class="reveal">
          <span class="section-label">Open Positions</span>
          <h2 class="section-heading">Current Openings</h2>
        </div>

        {openRoles.length === 0 ? (
          <div class="no-roles reveal stagger-1">
            <div class="nr-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0d9373" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
            </div>
            <h3>No Specific Roles Open Right Now</h3>
            <p>We don't always advertise. We hire great people when we find them. If you're a senior engineer who does exceptional work, send us your CV and a note about what you're looking for.</p>
            <a href="mailto:admin@awlabs.com.au" class="btn-primary">Send Your CV Anyway</a>
            <p class="collect-notice">We use your CV only to consider you for work with us. See our <a href="/privacy">privacy policy</a> for how we store it and how to ask us to delete it.</p>
          </div>
        ) : (
          <div class="roles-list">
            {openRoles.map((role: never) => <div>{JSON.stringify(role)}</div>)}
          </div>
        )}

        <div class="roles-types reveal stagger-2">
          <h3>Roles We Typically Hire For</h3>
          <div class="role-tags">
            {roles.map((r) => <span class="role-tag">{r}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- Hiring process -->
    <section class="process-section">
      <div class="careers-inner">
        <div class="reveal">
          <span class="section-label">Our Hiring Process</span>
          <h2 class="section-heading">Simple, Respectful, Fast</h2>
        </div>
        <div class="process-steps">
          {[
            { n: '01', title: 'Send your CV', desc: 'Email admin@awlabs.com.au with your CV and a short note about what you\'re looking for. No cover letter required; just be direct.' },
            { n: '02', title: 'Initial call (30 min)', desc: 'A conversation about your background, what you\'re looking for and whether there\'s a fit. We\'ll tell you about the team and what we\'re building.' },
            { n: '03', title: 'Technical review', desc: 'A focused technical assessment relevant to the role. We respect your time: no whiteboard theatrics or algorithmic trivia.' },
            { n: '04', title: 'Meet the team', desc: 'A call with the people you\'d be working with directly. Ask anything. We\'re honest about what it\'s like to work here.' },
            { n: '05', title: 'Offer', desc: 'If it\'s a fit, we move fast. You\'ll have an offer within 48 hours of your final interview.' },
          ].map((step, i) => (
            <div class={`proc-step reveal stagger-${i + 1}`}>
              <div class="ps-num">{step.n}</div>
              <div class="ps-content">
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  .collect-notice {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #8aa09a;
    max-width: 520px;
    margin: 1rem 0 0;
  }
  .no-roles .collect-notice { margin: 0; }
  .collect-notice a { color: #19b58f; }
  .careers-hero {
    padding: 9rem 0 6rem;
    background: #0a0f0e;
    position: relative;
    overflow: hidden;
  }
  .careers-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 30%, rgba(13,147,115,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .careers-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }
  .careers-title {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.875rem, 6vw, 4.5rem);
    font-weight: 800;
    color: white;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    max-width: 920px;
  }
  .careers-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.125rem;
    color: #8aa09a;
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .why-section { padding: 7rem 0; background: #0f1614; }
  .why-section .section-heading { margin-bottom: 3rem; }
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .value-card {
    background: #0a0f0e;
    border: 1px solid #1e2d28;
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s ease;
  }
  .value-card:hover { border-color: rgba(13,147,115,0.3); }
  .vc-emoji { width: 44px; height: 44px; border-radius: 12px; background: rgba(13,147,115,0.08); border: 1px solid rgba(13,147,115,0.15); display: flex; align-items: center; justify-content: center; color: #0d9373; }
  .value-card h3 { font-family: 'Sora', sans-serif; font-size: 1rem; font-weight: 600; color: white; margin: 0; }
  .value-card p { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; color: #7f978d; line-height: 1.6; margin: 0; }

  .roles-section { padding: 7rem 0; background: #0a0f0e; }
  .roles-section .section-heading { margin-bottom: 2.5rem; }

  .no-roles {
    background: linear-gradient(135deg, rgba(13,147,115,0.06) 0%, #0f1614 60%);
    border: 1px dashed rgba(13,147,115,0.3);
    border-radius: 20px;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 640px;
    margin-bottom: 4rem;
  }
  .nr-icon { width: 60px; height: 60px; border-radius: 16px; background: rgba(13,147,115,0.08); border: 1px solid rgba(13,147,115,0.2); display: flex; align-items: center; justify-content: center; }
  .no-roles h3 { font-family: 'Sora', sans-serif; font-size: 1.375rem; font-weight: 700; color: white; margin: 0; }
  .no-roles p { font-family: 'DM Sans', sans-serif; font-size: 0.9375rem; color: #7f978d; line-height: 1.65; margin: 0; }

  .roles-types { margin-top: 3rem; }
  .roles-types h3 { font-family: 'Sora', sans-serif; font-size: 1rem; font-weight: 600; color: #7f978d; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; margin-bottom: 1rem; }
  .role-tags { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .role-tag { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 500; color: #8aa09a; background: #0f1614; border: 1px solid #1e2d28; padding: 0.5rem 1.125rem; border-radius: 50px; }

  .process-section { padding: 7rem 0; background: #0f1614; }
  .process-section .section-heading { margin-bottom: 3rem; }
  .process-steps { display: flex; flex-direction: column; gap: 0; max-width: 800px; }
  .proc-step { display: grid; grid-template-columns: 70px 1fr; gap: 1.5rem; padding: 2rem 0; border-bottom: 1px solid #1e2d28; }
  .proc-step:last-child { border-bottom: none; }
  .ps-num { font-family: 'Sora', sans-serif; font-size: 2.5rem; font-weight: 800; color: rgba(13,147,115,0.2); letter-spacing: -0.05em; line-height: 1; }
  .ps-content h3 { font-family: 'Sora', sans-serif; font-size: 1.125rem; font-weight: 600; color: white; margin: 0 0 0.5rem; }
  .ps-content p { font-family: 'DM Sans', sans-serif; font-size: 0.9rem; color: #7f978d; line-height: 1.65; margin: 0; }

  @media (max-width: 900px) {
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .values-grid { grid-template-columns: 1fr; }
    .proc-step { grid-template-columns: 50px 1fr; }
  }
</style>
