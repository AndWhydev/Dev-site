---

<Layout
  title="Our Work | AWLabs"
  description="A selection of products AWLabs has built or helped build, grouped by industry. Most of our work stays private."
>
  <Header />
  <main>

    <section class="cs-framing" aria-label="About this showcase">
      <div class="cs-framing-inner reveal">
        <span class="section-label">Our work</span>
        <h1 class="cs-title">Products we&rsquo;ve built or helped build</h1>
        <p>
          <a href="https://allwebbedup.com.au" target="_blank" rel="noopener noreferrer">All Webbed Up</a> has been delivering for clients since 2021, and our founder has been shipping software since 2019. AWLabs launched in mid 2026 as a new, separate company, a partnership with exceptional developers and founders.
        </p>
        <p>
          Some of these products we built end to end. On others we built part of the product, such as a feature, an integration or the backend. Most of what we do stays private, so this is only a small part of it.
        </p>
        <a href="/our-journey" class="cs-framing-link">See the full journey <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </section>

    <section class="cs-list-section">
      <div class="cs-inner">
        <div class="cs-filter-wrap reveal">
          <div class="cs-filter" role="tablist" aria-label="Filter by category">
            <button class="cs-chip is-active" data-filter="all" role="tab" aria-selected="true">All</button>
            {categories.map((cat) => (
              <button class="cs-chip" data-filter={cat.id} role="tab" aria-selected="false">{cat.filterLabel}</button>
            ))}
          </div>
        </div>

        {categories.map((cat) => (
          <div class="cs-category" id={cat.id} data-cat={cat.id}>
            <div class="cs-cat-head reveal">
              <span class="cs-cat-label">{cat.label}</span>
              <h2 class="cs-cat-title">{cat.title}</h2>
              <p class="cs-cat-intro">{cat.intro}</p>
            </div>
            <div class="cs-grid">
              {cat.items.map((item, i) => {
                const CardTag = item.url ? 'a' : 'div';
                const cardProps = item.url
                  ? { href: item.url, target: '_blank', rel: 'noopener noreferrer' }
                  : {};
                return (
                  <CardTag
                    class={`cs-card reveal stagger-${Math.min(i + 1, 6)} ${!item.url ? 'cs-card-static' : ''}`}
                    {...cardProps}
                  >
                    <div class="cs-card-top">
                      <span class="cs-year">{item.year ?? ''}</span>
                      {item.url && (
                        <svg class="cs-ext-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M7 17L17 7M17 7H8M17 7v9"/>
                        </svg>
                      )}
                    </div>
                    <h3>{item.name}</h3>
                    <p>{item.description}</p>
                    {item.url && (
                      <span class="cs-card-arrow" aria-hidden="true">
                        Visit site
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </span>
                    )}
                  </CardTag>
                );
              })}
            </div>
          </div>
        ))}

        <div class="cs-more reveal">
          <div class="cs-more-inner">
            <span class="cs-more-label">Private builds</span>
            <h2 class="cs-more-title">
              More of our work<br />
              <span class="gradient-text">is private.</span>
            </h2>
            <p class="cs-more-copy">
              Most of our work is private. On a call, Andy can walk you through the work closest to yours.
            </p>
            <div class="cs-more-actions">
              <a href="/contact" class="btn-primary cs-more-btn">
                Talk to us about your industry
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/industries" class="cs-more-secondary">Browse industries we serve</a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  .cs-framing {
    padding: 8.5rem 0 3rem;
    background: #0a0f0e;
    position: relative;
    overflow: hidden;
  }
  .cs-framing::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 30%, rgba(13,147,115,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .cs-framing-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }
  .cs-framing-inner p {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(1rem, 1.9vw, 1.125rem);
    color: #cde0da;
    line-height: 1.75;
    margin: 0.75rem 0 1.25rem;
    max-width: 780px;
  }
  .cs-framing-inner p a {
    color: #0d9373;
    text-decoration: none;
    border-bottom: 1px solid rgba(13,147,115,0.4);
    transition: border-color 0.2s ease;
  }
  .cs-framing-inner p a:hover { border-color: #0d9373; }
  .cs-framing-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #0d9373;
    text-decoration: none;
    transition: gap 0.2s ease;
  }
  .cs-framing-link:hover { gap: 0.55rem; }

  .cs-hero {
    padding: 9rem 0 5rem;
    background: #0a0f0e;
    position: relative;
    overflow: hidden;
  }
  .cs-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 30%, rgba(13,147,115,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .cs-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }
  .breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-family: 'DM Sans', sans-serif; font-size: 0.8125rem; color: #4a6359; margin-bottom: 1.5rem; }
  .breadcrumb a { color: #4a6359; text-decoration: none; transition: color 0.2s; }
  .breadcrumb a:hover { color: #0d9373; }

  .cs-hero-title {
    font-family: 'Sora', sans-serif;
    font-size: clamp(2rem, 6vw, 4.25rem);
    font-weight: 800;
    color: white;
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin: 0.75rem 0 1.25rem;
    max-width: 780px;
  }
  .cs-hero-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.125rem;
    color: #cde0da;
    max-width: 660px;
    line-height: 1.7;
    margin: 0 0 1.25rem;
  }
  .cs-hero-note {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    color: #8aa09a;
    max-width: 620px;
    line-height: 1.7;
    margin: 0;
    padding: 1rem 1.125rem;
    background: rgba(13,147,115,0.04);
    border-left: 2px solid rgba(13,147,115,0.35);
    border-radius: 0 10px 10px 0;
  }
  .cs-hero-note a { color: #0d9373; text-decoration: none; border-bottom: 1px solid rgba(13,147,115,0.35); }
  .cs-hero-note a:hover { color: #12b389; border-color: #12b389; }

  .cs-list-section {
    padding: 5rem 0 7rem;
    background: #0a0f0e;
  }
  .cs-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Filter bar */
  .cs-filter-wrap {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 0 -2rem 1rem;
    padding: 1.25rem 2rem;
    background: rgba(10, 15, 14, 0.85);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid #1e2d28;
  }
  .cs-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  .cs-chip {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #cde0da;
    background: #0f1614;
    border: 1px solid #1e2d28;
    border-radius: 50px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }
  .cs-chip:hover {
    color: white;
    border-color: rgba(13,147,115,0.55);
    background: #101a17;
  }
  .cs-chip.is-active {
    color: #0a0f0e;
    background: #0d9373;
    border-color: #0d9373;
  }
  .cs-chip.is-active:hover {
    background: #12b389;
    border-color: #12b389;
    color: #0a0f0e;
  }
  .cs-chip:focus-visible {
    outline: 2px solid #0d9373;
    outline-offset: 2px;
  }

  /* Categories */
  .cs-category {
    padding: 3rem 0 3.5rem;
