---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTABanner from '../../components/CTABanner.astro';

interface ShowcaseItem {
  name: string;
  year: string;
  description: string;
  url?: string;
}

interface Category {
  id: string;
  filterLabel: string;
  label: string;
  title: string;
  intro: string;
  items: ShowcaseItem[];
}

