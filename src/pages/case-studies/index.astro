<script>
  function bindCaseStudyFilter() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.cs-chip');
    const cats = document.querySelectorAll<HTMLElement>('.cs-category');
    if (!chips.length || !cats.length) return;

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter;
        chips.forEach((c) => {
          const active = c === chip;
          c.classList.toggle('is-active', active);
          c.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        cats.forEach((cat) => {
          const show = filter === 'all' || cat.dataset.cat === filter;
          cat.style.display = show ? '' : 'none';
        });
        if (filter && filter !== 'all') {
          const target = document.getElementById(filter);
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  bindCaseStudyFilter();
  document.addEventListener('astro:after-swap', bindCaseStudyFilter);
</script>
