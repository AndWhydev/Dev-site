---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroWebGL from '../components/HeroWebGL.astro';
import TrustBar from '../components/TrustBar.astro';
import LiveAppDemo from '../components/LiveAppDemo.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Process from '../components/Process.astro';
import TeamSection from '../components/TeamSection.astro';
import CTABanner from '../components/CTABanner.astro';
import AutonomousAISection from '../components/sections/AutonomousAISection.astro';
import FeaturedGuides from '../components/FeaturedGuides.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import FactBlock from '../components/FactBlock.astro';

const siteUrl = 'https://www.awlabs.com.au';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'AWLabs',
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'en-AU',
};
---

<Layout
  title="AI and Software Development, Sydney | AWLabs"
  description="Sydney AI and software development for growing businesses and enterprise. AI agents, RAG, LLM integration and custom software, led by senior engineers."
  extraSchema={[websiteSchema]}
>
  <Header />
  <main>
    <HeroWebGL />

    <TrustBar />

    <TeamSection />

    <AutonomousAISection />

    <!-- Entity definition band (GEO entity locking) -->
    <section class="home-entity" aria-label="About AWLabs">
      <div class="home-entity-inner reveal">
        <p>
          <strong>AWLabs</strong> is a Sydney based AI and software development company for growing businesses and enterprise.
          Sister company to <a href="https://allwebbedup.com.au" target="_blank" rel="noopener noreferrer">All Webbed Up</a>,
          a separate websites and marketing company.
        </p>
        <p class="home-entity-timeline">
          Our founder has been shipping software since 2019, and All Webbed Up has been delivering for clients since 2021. AWLabs launched in mid 2026 as a new, separate company: a partnership with exceptional developers and founders. <a href="/our-journey">Our full journey</a>.
        </p>
        <div class="home-entity-sister">
          <a href="https://allwebbedup.com.au" target="_blank" rel="noopener noreferrer" class="sister-pill">
            <span class="sister-pill-label">Sister brand</span>
            <span class="sister-pill-arrow">&rarr;</span>
            <span class="sister-pill-name">All Webbed Up</span>
            <span class="sister-pill-sub">Marketing &amp; brand</span>
          </a>
        </div>
      </div>
    </section>

    <LiveAppDemo />
    <ServicesGrid />

    <FeaturedGuides />
    <Process />
    <VideoTestimonials />
    <p class="home-stories-link">
      <a href="/client-stories">
        See all client stories
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </p>
    <GoogleReviews />
    <section class="home-facts" aria-label="AWLabs at a glance">
      <div class="home-facts-inner reveal">
        <FactBlock />
      </div>
    </section>
    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  .home-facts {
    background: #0a0f0e;
    padding: clamp(3rem, 6vw, 5rem) 1.5rem;
  }
  .home-facts-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  /* Sits under the video section, pulled up into its bottom padding */
  .home-stories-link {
    margin: clamp(-3.5rem, -5vw, -2rem) 0 0;
    padding: 0 1.5rem clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }
  .home-stories-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.6rem 1.25rem;
    border: 1px solid #1e2d28;
    border-radius: 999px;
    background: #0f1614;
    color: #d5e0dc;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .home-stories-link a:hover,
  .home-stories-link a:focus-visible { border-color: #0d9373; color: #fff; }
  .home-entity {
    background: #0a0f0e;
    padding: 3.5rem 2rem;
    border-bottom: 1px solid #1e2d28;
  }
  .home-entity-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .home-entity-inner p {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 500;
    color: #cde0da;
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin: 0;
    text-align: center;
  }
  .home-entity-timeline {
    font-family: 'DM Sans', sans-serif !important;
    font-size: clamp(0.9375rem, 1.7vw, 1.0625rem) !important;
    font-weight: 400 !important;
    color: #8aa09a !important;
    line-height: 1.7 !important;
    letter-spacing: 0 !important;
    margin-top: 1rem !important;
    max-width: 780px;
  }
  /* Beats `.home-entity-inner p { margin: 0 }` so the capped block stays centred. */
  .home-entity-inner .home-entity-timeline { margin: 1rem auto 0 !important; }
  .home-entity-inner strong { color: white; font-weight: 700; }
  .home-entity-inner a {
    color: #0d9373;
    text-decoration: none;
    border-bottom: 1px solid rgba(13,147,115,0.4);
    transition: border-color 0.2s ease;
  }
  .home-entity-inner a:hover { border-color: #0d9373; }

  .home-entity-sister {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .sister-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 1.1rem 0.7rem 0.85rem;
    background: rgba(13,147,115,0.08);
    border: 1px solid rgba(13,147,115,0.35);
    border-radius: 999px;
    font-family: 'DM Sans', sans-serif;
    text-decoration: none !important;
    border-bottom: 1px solid rgba(13,147,115,0.35) !important;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .sister-pill:hover {
    background: rgba(13,147,115,0.14);
    border-color: #0d9373 !important;
    transform: translateY(-1px);
  }
  .sister-pill-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0d9373;
    padding: 0.15rem 0.55rem;
    background: rgba(13,147,115,0.15);
    border-radius: 999px;
  }
  .sister-pill-arrow {
    font-family: 'Sora', sans-serif;
    color: #0d9373;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .sister-pill-name {
    font-family: 'Sora', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: white;
    letter-spacing: -0.01em;
  }
  .sister-pill-sub {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #8aa09a;
    border-left: 1px solid #2a3d35;
    padding-left: 0.75rem;
    margin-left: 0.15rem;
  }
  @media (max-width: 520px) {
    .sister-pill { flex-wrap: wrap; justify-content: center; }
    .sister-pill-sub { border-left: none; padding-left: 0; margin-left: 0; width: 100%; text-align: center; }
  }
</style>
