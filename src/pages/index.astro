---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroWebGL from '../components/HeroWebGL.astro';
import TrustBar from '../components/TrustBar.astro';
import LiveAppDemo from '../components/LiveAppDemo.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Process from '../components/Process.astro';
import TeamSection from '../components/TeamSection.astro';
import CTABanner from '../components/CTABanner.astro';
import AutonomousAISection from '../components/sections/AutonomousAISection.astro';
import FeaturedGuides from '../components/FeaturedGuides.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import FactBlock from '../components/FactBlock.astro';
import { LOCAL_BUSINESS_SCHEMA, ORG_ID } from '../config/site';

const siteUrl = 'https://www.awlabs.com.au';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'AWLabs',
  url: siteUrl,
  publisher: { '@id': ORG_ID },
  inLanguage: 'en-AU',
};

// Visible FAQ, also emitted as FAQPage JSON-LD so the two never drift.
// Answers reuse wording already on the site (ai-consulting, startup-mvp,
// about, trust) so every claim matches its source page.
const faqs = [
  {
    q: 'How much does it cost to build software with AWLabs?',
    a: 'It depends on scope, so rather than quote ranges out of context, we start with a 15 minute Development Consult, then the Discovery Audit (a fixed fee, credited in full against your build). You then get a fixed price Schedule of Work covering development, integration, testing and a 30 day warranty, paid in three payments: a deposit on signing, a second payment when you accept the first stage, and the final payment before handover.',
  },
  {
    q: 'How long does a build take?',
    a: 'Your developer estimates the build in weeks once the scope is clear. A smaller build can be faster, and one with complex integrations or compliance requirements can take longer. The biggest factor is scope discipline: a first version that tries to be the full product takes as long as the full product. You see progress every Tuesday and Friday.',
  },
  {
    q: 'Who owns the code?',
    a: 'You own what we build for you once it is paid for. Each part is assigned to you as it is paid for in full. You can see and test the code while we build, and the full repository, logins and accounts are handed over after the final payment. Our own reusable tools stay ours, with a permanent licence for you to use them inside your product.',
  },
  {
    q: 'Is your team in Australia?',
    a: 'Yes. Our team is based in Sydney, NSW, operating across Australia and internationally, with clients supported during Sydney business hours. AWLabs is 100% Australian owned with no offshore parent, and delivery is led from Australia and remains managed and accountable through AW Labs in Sydney.',
  },
  {
    q: 'What AI work do you do?',
    a: 'We build AI agents, RAG knowledge bases, LLM integrations, AI chatbots, AI document processing, MCP servers and private LLM deployments. We start by identifying where AI will genuinely pay off, test whether it works on your own data, and design how it fits your systems, security and compliance obligations. The same team that assesses the opportunity builds, evaluates and deploys the system.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${siteUrl}/#faq`,
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title="AI and Software Development, Sydney | AWLabs"
  description="Sydney AI and software development for growing businesses and enterprise. AI agents, RAG, LLM integration and custom software, led by senior engineers."
  extraSchema={[websiteSchema, LOCAL_BUSINESS_SCHEMA, faqSchema]}
>
  <Header />
  <main>
    <HeroWebGL />

    <TrustBar />

    <TeamSection heading="Who will actually build my software?" />

    <AutonomousAISection />

    <!-- Entity definition band (GEO entity locking) -->
    <section class="home-entity" aria-label="About AWLabs">
      <div class="home-entity-inner reveal">
        <p>
          <strong>AWLabs</strong> is a Sydney based AI and software development company for growing businesses and enterprise.
          Sister company to <a href="https://allwebbedup.com.au" target="_blank" rel="noopener noreferrer">All Webbed Up</a>,
          a separate websites and marketing company.
        </p>
        <p class="home-entity-timeline">
          Our founder has been shipping software since 2019, and All Webbed Up has been delivering for clients since 2021. AWLabs launched in mid 2026 as a new, separate company: a partnership with exceptional developers and founders. <a href="/our-journey">Our full journey</a>.
        </p>
        <div class="home-entity-sister">
          <a href="https://allwebbedup.com.au" target="_blank" rel="noopener noreferrer" class="sister-pill">
            <span class="sister-pill-label">Sister brand</span>
            <span class="sister-pill-arrow">&rarr;</span>
            <span class="sister-pill-name">All Webbed Up</span>
            <span class="sister-pill-sub">Marketing &amp; brand</span>
          </a>
        </div>
      </div>
    </section>

    <LiveAppDemo />
    <ServicesGrid />

    <FeaturedGuides />
    <Process />
    <VideoTestimonials heading="What do clients say about working with AWLabs?" />
    <p class="home-stories-link">
      <a href="/client-stories">
        See all client stories
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </p>
    <GoogleReviews />
    <section class="home-faq" aria-labelledby="home-faq-heading">
      <div class="home-faq-inner reveal">
        <span class="section-label">FAQ</span>
        <h2 class="section-heading" id="home-faq-heading">Common questions.</h2>
        <div class="home-faq-list">
          {faqs.map((f) => (
            <details class="home-faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="home-facts" aria-label="AWLabs at a glance">
      <div class="home-facts-inner reveal">
        <FactBlock />
      </div>
    </section>
    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  .home-faq {
    background: #0a0f0e;
    padding: clamp(3rem, 6vw, 5rem) 1.5rem 0;
  }
  .home-faq-inner { max-width: 880px; margin: 0 auto; }
  .home-faq-list { margin-top: 1.75rem; border-top: 1px solid #1e2d28; }
  .home-faq-item { border-bottom: 1px solid #1e2d28; }
  .home-faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    padding: 1.1rem 0;
    font-family: 'Sora', sans-serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
    list-style: none;
  }
  .home-faq-item summary::-webkit-details-marker { display: none; }
  .home-faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    color: #0d9373;
    font-size: 1.4rem;
    font-weight: 400;
    transition: transform 0.2s ease;
  }
  .home-faq-item[open] summary::after { transform: rotate(45deg); }
  .home-faq-item summary:focus-visible { outline: 2px solid #0d9373; outline-offset: 4px; }
  .home-faq-item p {
    margin: 0 0 1.25rem;
    color: #a9bcb5;
    line-height: 1.7;
    max-width: 72ch;
  }
  .home-facts {
    background: #0a0f0e;
    padding: clamp(3rem, 6vw, 5rem) 1.5rem;
  }
  .home-facts-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  /* Sits under the video section, pulled up into its bottom padding */
  .home-stories-link {
    margin: clamp(-3.5rem, -5vw, -2rem) 0 0;
    padding: 0 1.5rem clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }
  .home-stories-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.6rem 1.25rem;
    border: 1px solid #1e2d28;
    border-radius: 999px;
    background: #0f1614;
    color: #d5e0dc;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .home-stories-link a:hover,
  .home-stories-link a:focus-visible { border-color: #0d9373; color: #fff; }
  .home-entity {
    background: #0a0f0e;
    padding: 3.5rem 2rem;
    border-bottom: 1px solid #1e2d28;
  }
  .home-entity-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .home-entity-inner p {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 500;
    color: #cde0da;
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin: 0;
    text-align: center;
  }
  .home-entity-timeline {
    font-family: 'DM Sans', sans-serif !important;
    font-size: clamp(0.9375rem, 1.7vw, 1.0625rem) !important;
    font-weight: 400 !important;
    color: #8aa09a !important;
    line-height: 1.7 !important;
    letter-spacing: 0 !important;
    margin-top: 1rem !important;
    max-width: 780px;
  }
  /* Beats `.home-entity-inner p { margin: 0 }` so the capped block stays centred. */
  .home-entity-inner .home-entity-timeline { margin: 1rem auto 0 !important; }
  .home-entity-inner strong { color: white; font-weight: 700; }
  .home-entity-inner a {
    color: #0d9373;
    text-decoration: none;
    border-bottom: 1px solid rgba(13,147,115,0.4);
    transition: border-color 0.2s ease;
  }
  .home-entity-inner a:hover { border-color: #0d9373; }

  .home-entity-sister {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .sister-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 1.1rem 0.7rem 0.85rem;
    background: rgba(13,147,115,0.08);
    border: 1px solid rgba(13,147,115,0.35);
    border-radius: 999px;
    font-family: 'DM Sans', sans-serif;
    text-decoration: none !important;
    border-bottom: 1px solid rgba(13,147,115,0.35) !important;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .sister-pill:hover {
    background: rgba(13,147,115,0.14);
    border-color: #0d9373 !important;
    transform: translateY(-1px);
  }
  .sister-pill-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0d9373;
    padding: 0.15rem 0.55rem;
    background: rgba(13,147,115,0.15);
    border-radius: 999px;
  }
  .sister-pill-arrow {
    font-family: 'Sora', sans-serif;
    color: #0d9373;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .sister-pill-name {
    font-family: 'Sora', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: white;
    letter-spacing: -0.01em;
  }
  .sister-pill-sub {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #8aa09a;
    border-left: 1px solid #2a3d35;
    padding-left: 0.75rem;
    margin-left: 0.15rem;
  }
  @media (max-width: 520px) {
    .sister-pill { flex-wrap: wrap; justify-content: center; }
    .sister-pill-sub { border-left: none; padding-left: 0; margin-left: 0; width: 100%; text-align: center; }
  }
</style>
