---
import { BRAND } from '../config/brand';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForms from '../components/LeadForms.astro';
import {
  LOCAL_BUSINESS_SCHEMA, ADDRESS_LINE, PHONE_DISPLAY, PHONE_TEL, GOOGLE_MAPS_URL,
  GOOGLE_MAP_EMBED_URL, GOOGLE_REVIEWS_URL, GOOGLE_REVIEW_COUNT, GOOGLE_RATING,
} from '../config/site';
---

<Layout
  title="Contact Us: Book a Development Consult, Sydney | AWLabs"
  description="Book a Development Consult with AWLabs, a Sydney AI and software development company. Tell us what you want to build and we will be in touch to book a time."
  extraSchema={[LOCAL_BUSINESS_SCHEMA]}
>
  <Header />
  <main>
    <section class="contact-section">
      <div class="contact-inner">

        <!-- Left: info + what happens next -->
        <div class="contact-info reveal-left">
          <span class="section-label">Get In Touch</span>
          <h1 class="contact-title">
            Tell us what you<br />
            <span class="gradient-text">need built.</span>
          </h1>
          <p class="contact-sub">Whether you have a detailed brief or an idea you're still exploring, we want to hear about it. We reply to every enquiry within 1 business day.</p>

          <div class="contact-details">
            <a href={`mailto:${BRAND.email}`} class="contact-item">
              <div class="ci-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d9373" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div class="ci-label">Email</div>
                <div class="ci-val">{BRAND.email}</div>
              </div>
            </a>
            <a href={`tel:${PHONE_TEL}`} class="contact-item">
              <div class="ci-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d9373" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.67A2 2 0 012.18 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 8.15a16 16 0 006.29 6.29l1.42-1.42a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 15.16v.76z"/></svg>
              </div>
              <div>
                <div class="ci-label">Phone</div>
                <div class="ci-val">{PHONE_DISPLAY}</div>
              </div>
            </a>
            <div class="contact-item">
              <div class="ci-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d9373" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <div class="ci-label">Hours</div>
                <div class="ci-val">{BRAND.hours.text.replace(' Sydney time', '')}</div>
                <div class="ci-sub">Sydney time. We reply within 1 business day.</div>
              </div>
            </div>
            <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener" class="contact-item">
              <div class="ci-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d9373" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <div class="ci-label">Office</div>
                <div class="ci-val">AWLabs, {ADDRESS_LINE}</div>
                <div class="ci-sub">Open in Google Maps</div>
              </div>
            </a>
            <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" class="contact-item">
              <div class="ci-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d9373" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </div>
              <div>
                <div class="ci-label">Google reviews</div>
                <div class="ci-val">{GOOGLE_RATING.toFixed(1)} from {GOOGLE_REVIEW_COUNT} reviews</div>
                <div class="ci-sub">Read our reviews on Google</div>
              </div>
            </a>
          </div>

          <div class="contact-map">
            <iframe
              src={GOOGLE_MAP_EMBED_URL}
              title={`Map showing AWLabs at ${ADDRESS_LINE}`}
              width="600"
              height="300"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>

          <!-- What happens next -->
          <div class="next-steps">
            <h3>What Happens Next</h3>
            <div class="next-step">
              <div class="ns-num">1</div>
              <div>
                <strong>Development Consult</strong>
                <p>A short phone call about what you want to build, so we can tell you whether we are the right fit.</p>
              </div>
            </div>
            <div class="next-step">
              <div class="ns-num">2</div>
              <div>
                <strong>Discovery Audit</strong>
                <p>Two sessions on Zoom with Andy about what you need built, the data and the risks. Your written audit follows within seven days. The fee is credited in full against your build.</p>
              </div>
            </div>
            <div class="next-step">
              <div class="ns-num">3</div>
              <div>
                <strong>Your fixed price proposal</strong>
                <p>We walk you through the audit, then present a fixed price Schedule of Work with three options: The Minimum, The Recommended and The Complete.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: booking + form -->
        <div class="contact-form-col reveal-right stagger-1">
          <LeadForms />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact-section {
    padding: 8rem 0;
    background: #0a0f0e;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }
  .contact-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 60% at 30% 30%, rgba(13,147,115,0.05) 0%, transparent 65%);
    pointer-events: none;
  }
  .contact-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    align-items: start;
    position: relative;
    z-index: 1;
  }
  .contact-title {
    font-family: 'Sora', sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: white;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }
  .contact-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.0625rem;
    color: #8aa09a;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .contact-map {
    margin: 0 0 2rem;
    border: 1px solid #1e2d28;
    border-radius: 12px;
    overflow: hidden;
    background: #0f1614;
  }
  .contact-map iframe {
    display: block;
    width: 100%;
    height: 260px;
    border: 0;
    filter: grayscale(0.3) contrast(1.05);
  }
  .contact-details {
    background: #0f1614;
    border: 1px solid #1e2d28;
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .ci-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: rgba(13,147,115,0.08);
    border: 1px solid rgba(13,147,115,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ci-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7f978d;
    margin-bottom: 0.2rem;
  }
  .ci-val {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    color: white;
    line-height: 1.4;
  }
  .ci-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    color: #7f978d;
    margin-top: 1px;
  }
  .next-steps h3 {
    font-family: 'Sora', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: white;
    margin: 0 0 1.25rem;
  }
  .next-step {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .ns-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(13,147,115,0.1);
    border: 1px solid rgba(13,147,115,0.25);
    color: #0d9373;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Sora', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .next-step strong {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: white;
    margin-bottom: 0.25rem;
  }
  .next-step p {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: #7f978d;
    margin: 0;
    line-height: 1.5;
  }


  @media (max-width: 1024px) {
    .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 640px) {
    .contact-section { padding: 6rem 0; }
  }
</style>
