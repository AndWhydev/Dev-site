---
import { getCollection, render } from 'astro:content';
import LongformLayout from '../../layouts/LongformLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('solutions');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const crumbs = [
  { title: 'Home', href: '/' },
  { title: 'Solutions', href: '/solutions' },
  { title: entry.data.industry.title, href: entry.data.industry.href },
  { title: entry.data.title },
];
---

<LongformLayout data={entry.data} crumbs={crumbs} headings={headings} schemaType="Service">
  <Content />
</LongformLayout>
