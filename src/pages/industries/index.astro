---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTABanner from '../../components/CTABanner.astro';
import { industryIcon } from './_icons';

const industries = [
  { name: 'Financial Services', desc: 'Banks, insurers, super funds and fintech companies', href: '/industries/finance-fintech', tags: ['APRA CPS 234', 'Open Banking', 'AML/KYC'] },
  { name: 'Healthcare', desc: 'Hospitals, telehealth providers and allied health', href: '/industries/healthcare', tags: ['ADHA', 'HL7 FHIR', 'My Health Record'] },
  { name: 'Logistics & Transport', desc: 'Fleet management, warehousing and last mile delivery', href: '/industries/logistics-transport', tags: ['Fleet Tracking', 'HVNL', 'WMS'] },
  { name: 'Retail & Ecommerce', desc: 'Omnichannel retail, marketplace and D2C brands', href: '/industries/retail-ecommerce', tags: ['Omnichannel', 'POS', 'Loyalty'] },
  { name: 'Education', desc: 'Universities, RTOs and EdTech companies', href: '/industries/education', tags: ['AVETMISS', 'LMS', 'Student Portals'] },
  { name: 'Government', desc: 'Federal, state and local government agencies', href: '/industries/government-enterprise', tags: ['ISM', 'PSPF', 'Citizen Services'] },
  { name: 'Construction & Trades', desc: 'Builders, subcontractors and project managers', href: '/industries/construction-trades', tags: ['Job Mgmt', 'SOPA', 'Safety'] },
  { name: 'Real Estate', desc: 'Agencies, property managers and developers', href: '/industries/real-estate', tags: ['PMS', 'Tenant Portals', 'PropTech'] },
  { name: 'Hospitality & Tourism', desc: 'Hotels, restaurants and tourism operators', href: '/industries/hospitality', tags: ['Booking Engine', 'PMS', 'Guest Apps'] },
  { name: 'Sports & Recreation', desc: 'Sporting organisations, clubs and venues', href: '/industries/sports-recreation', tags: ['Member Mgmt', 'PlayHQ', 'Fan Engagement'] },
  { name: 'Web3 & Crypto', desc: 'Exchanges, DeFi protocols and NFT platforms', href: '/industries/web3-crypto', tags: ['Smart Contracts', 'AUSTRAC', 'DeFi'] },
  { name: 'AI & Automation', desc: 'Organisations deploying AI in production', href: '/industries/ai-automation', tags: ['Custom LLMs', 'RAG', 'ML Ops'] },
  { name: 'Manufacturing', desc: 'Manufacturers, fabricators and industrial suppliers', href: '/industries/manufacturing', tags: ['ERP Integration', 'Quality Data', 'Traceability'] },
];

const metaTitle = 'Software Development by Industry in Australia | AWLabs';
const metaDescription = "Software and AI development shaped by each industry's rules, for Australian organisations in healthcare, fintech, construction, logistics and government.";
const siteUrl = 'https://www.awlabs.com.au';
const pageUrl = `${siteUrl}/industries`;
const extraSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Software development by industry',
    description: metaDescription,
    url: pageUrl,
    publisher: { '@id': `${siteUrl}/#organization` },
    hasPart: industries.map((i) => ({ '@type': 'WebPage', name: i.name, url: `${siteUrl}${i.href}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: pageUrl },
    ],
  },
];
---

<Layout
  title={metaTitle}
  description={metaDescription}
  extraSchema={extraSchema}
>
  <Header />
  <main>
    <section class="industries-hero">
      <div class="ind-inner">
        <div class="reveal">
          <span class="section-label">Industries</span>
          <h1 class="ind-title">
            We Don't Just Write Code.<br />
            <span class="gradient-text">We Understand Your Industry.</span>
          </h1>
          <p class="ind-sub">
            Software development for Australian organisations, shaped by the rules, systems and workflows of each sector, so fewer assumptions make it into the build.
            We speak your language, from regulatory requirements to the way your teams actually work.
          </p>
        </div>
      </div>
    </section>

    <section class="industries-grid-section">
      <div class="ind-inner">
        <div class="ind-grid">
          {industries.map((ind, i) => (
            <a href={ind.href} class={`ind-card card-hover reveal stagger-${Math.min((i % 4) + 1, 4)}`}>
              <div class="ind-card-top">
                <div class="ind-card-icon" set:html={industryIcon(ind.href.split('/').pop() ?? '', 24)} />
                <svg class="ind-card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
              <h2 class="ind-card-name">{ind.name}</h2>
              <p class="ind-card-desc">{ind.desc}</p>
              <div class="ind-card-tags">
                {ind.tags.map((t) => <span class="ind-card-tag">{t}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Why domain expertise matters -->
    <section class="expertise-section">
      <div class="ind-inner">
        <div class="expertise-narrative reveal-left">
          <span class="section-label">Why It Matters</span>
          <h2 class="section-heading">Why Industry Knowledge Changes the Build</h2>
          <p>A healthcare platform has fundamentally different requirements to a logistics system. Compliance obligations, data sensitivity, integration landscape, user personas and workflow patterns all differ. Generic software development produces generic outcomes.</p>
          <p>We brief the AI workers in our build pipeline with the constraints of each industry before they touch a line of code: APRA and CDR for financial services, the ACSC ISM and Essential Eight for government, AVETMISS for vocational education, AHPRA and My Health Record interoperability for healthcare. The framing shapes every architectural choice that follows.</p>
          <p>For a deeper look at how the rules change the build in specific sectors, including healthcare, financial services, government, education, construction and logistics, see our <a href="/solutions">industry solutions</a>.</p>
          <p>That domain depth translates into faster scoping, fewer rounds of revisions, fewer incorrect assumptions, and ultimately, software that works the way your people work.</p>
        </div>
      </div>
    </section>

    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  .industries-hero {
    padding: 9rem 0 5rem;
    background: #0a0f0e;
    position: relative;
    overflow: hidden;
  }
  .industries-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 30%, rgba(13,147,115,0.08) 0%, transparent 65%);
    pointer-events: none;
  }
  .ind-inner { max-width: 1280px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 1; }
  .ind-title {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.75rem, 5.5vw, 4rem);
    font-weight: 800;
    color: white;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    max-width: 780px;
  }
  .ind-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.125rem;
    color: #8aa09a;
    max-width: 640px;
    line-height: 1.7;
    margin: 0;
  }

  .industries-grid-section { padding: 5rem 0 7rem; background: #0a0f0e; }
  .ind-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .ind-card {
    background: #0f1614;
    border: 1px solid #1e2d28;
    border-radius: 18px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
  }
  .ind-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ind-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0d9373;
    background: rgba(13,147,115,0.08);
    border: 1px solid rgba(13,147,115,0.2);
  }
  .ind-card-arrow { color: #7f978d; transition: color 0.2s ease, transform 0.2s ease; }
  .ind-card:hover .ind-card-arrow { color: #0d9373; transform: translateX(3px); }
  .ind-card-name {
    font-family: 'Sora', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: white;
    margin: 0;
    line-height: 1.2;
  }
  .ind-card-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: #7f978d;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }
  .ind-card-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .ind-card-tag {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.625rem;
    font-weight: 600;
    color: #0d9373;
    background: rgba(13,147,115,0.08);
    border: 1px solid rgba(13,147,115,0.18);
    padding: 0.175rem 0.475rem;
    border-radius: 4px;
  }

  .expertise-section { padding: 7rem 0; background: #0f1614; }
  .expertise-narrative { max-width: 780px; }
  .expertise-section p { font-family: 'DM Sans', sans-serif; font-size: 1.0625rem; color: #8aa09a; line-height: 1.75; margin: 0 0 1.25rem; }

  @media (max-width: 1100px) { .ind-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 800px) { .ind-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .ind-grid { grid-template-columns: 1fr; } }
</style>
