---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';

const milestones = [
  {
    year: '2019',
    phase: 'Pre-agency',
    title: 'Freelance foundations',
    body: 'Two years of solo freelance before any agency existed. Shipping marketing sites, small applications and one-off automation work for direct clients. This is where the "build things that ship" bias was formed, no account layer between the person writing the brief and the person writing the code.',
  },
  {
    year: '2021',
    phase: 'All Webbed Up',
    title: 'The full-service agency',
    body: 'All Webbed Up (AWU) was founded in Sydney as a full-service marketing and web development agency. Five years of client work followed, ranging from brand and website builds through to custom software and internal tools. AWU is still running today, now sharpened to its marketing and brand practice.',
  },
  {
    year: '2026',
    phase: 'All Webbed Labs',
    title: 'The software split',
    body: 'All Webbed Labs (AWL) launched in mid 2026 as the dedicated software engineering and applied AI arm. AW Labs Pty Ltd is a new legal entity, but the work is not, it formalises the enterprise engineering and AI practice that had been running inside AWU for years, under its own brand.',
  },
];
---

<Layout
  title="Our Journey, From Freelance to All Webbed Labs | All Webbed Labs"
  description="The timeline behind All Webbed Labs. Two years of pre-agency freelance, five years of All Webbed Up, and the mid 2026 split that put a dedicated software and AI arm under its own brand."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="oj-hero">
      <div class="oj-hero-inner">
        <div class="reveal">
          <span class="section-label">Our Journey</span>
          <h1 class="oj-title">
            Seven years of shipping,<br />
            <span class="gradient-text">one company at a time.</span>
          </h1>
          <p class="oj-lead">
            All Webbed Labs is new. The team, the standards and the track record behind it are not. Two years of pre-agency freelance, five years running All Webbed Up as a Sydney marketing and development agency, and a mid 2026 split that put the software and AI practice under its own brand.
          </p>
          <p class="oj-sub">
            Twenty plus years of combined engineering experience across the current team, brought together deliberately so that neither the marketing side nor the software side pulls focus from the other.
          </p>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="oj-timeline">
      <div class="oj-timeline-inner">
        <div class="reveal">
          <span class="section-label">Timeline</span>
          <h2 class="section-heading">Three phases, one continuous thread.</h2>
        </div>
        <div class="oj-milestones">
          {milestones.map((m, i) => (
            <article class={`oj-milestone reveal stagger-${i + 1}`}>
              <div class="oj-year">{m.year}</div>
              <div class="oj-body">
                <span class="oj-phase">{m.phase}</span>
                <h3 class="oj-mile-title">{m.title}</h3>
                <p>{m.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Why the split -->
    <section class="oj-split">
      <div class="oj-split-inner">
        <div class="oj-split-grid">
          <div class="reveal-left">
            <span class="section-label">Why We Split</span>
            <h2 class="section-heading">Two brands, one shared operating standard.</h2>
            <p>Full-service agencies drift. Marketing wins the pitch, then the engineering side gets treated as an implementation detail. Or the reverse, technical shops that inherit marketing work and produce serviceable brand assets nobody is proud of.</p>
            <p>Splitting AWU and AWL fixes both failure modes. Each entity has a dedicated senior team, its own commercials, and permission to say no to the work that does not belong in it. When a client needs both, the two companies collaborate end to end. When they only need one, they get the specialist without paying for the other half.</p>
            <p>The operating standards, transparency, senior only delivery, direct access to the people building your product, are shared. The specialisations are not.</p>
          </div>
          <div class="oj-split-cards reveal-right stagger-2">
            <div class="oj-split-card">
              <div class="oj-split-mark">AWU</div>
              <div class="oj-split-body">
                <strong>All Webbed Up</strong>
                <span>Sydney marketing and branding agency. Brand systems, campaign work, marketing sites, content and creative direction. Five years live, still running.</span>
                <a href="https://allwebbedup.com.au" target="_blank" rel="noopener noreferrer">allwebbedup.com.au &rarr;</a>
              </div>
            </div>
            <div class="oj-split-card is-primary">
              <div class="oj-split-mark">AWL</div>
              <div class="oj-split-body">
                <strong>All Webbed Labs</strong>
                <span>Enterprise software and applied AI. Custom apps, LLM and RAG tooling, cloud infrastructure, staff augmentation. Formalised as its own company mid 2026.</span>
                <a href="/">awlabs.com.au &rarr;</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Team experience callout -->
    <section class="oj-team">
      <div class="oj-team-inner">
        <div class="reveal" style="text-align: center; max-width: 780px; margin: 0 auto;">
          <span class="section-label">Team Experience</span>
          <h2 class="section-heading">Twenty plus years, across the current team.</h2>
          <p class="oj-team-copy">The seven year company history is not the whole picture. The engineers, AI specialists and delivery leads at All Webbed Labs bring more than two decades of combined experience from enterprise software, marketing platforms, applied AI and startup product work before AWL existed. That is why a new legal entity ships like an experienced one on day one.</p>
          <div class="oj-team-actions">
            <a href="/about#team" class="btn-primary">Meet the team</a>
            <a href="/case-studies" class="btn-outline">See the work we build to</a>
          </div>
        </div>
      </div>
    </section>

    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  /* Hero */
  .oj-hero {
    padding: 10rem 0 6rem;
    background: #0a0f0e;
    position: relative;
    overflow: hidden;
  }
  .oj-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 30%, rgba(13,147,115,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .oj-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }
  .oj-title {
    font-family: 'Sora', sans-serif;
    font-size: clamp(2rem, 6.5vw, 4.5rem);
    font-weight: 800;
    color: white;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    max-width: 820px;
    overflow-wrap: break-word;
  }
  .oj-lead {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    font-weight: 500;
    color: #cde0da;
    max-width: 740px;
    line-height: 1.6;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    border-left: 2px solid #0d9373;
    background: rgba(13,147,115,0.05);
    border-radius: 0 10px 10px 0;
    overflow-wrap: break-word;
  }
  .oj-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: #8aa09a;
    max-width: 720px;
    line-height: 1.75;
    margin-bottom: 0;
  }

  /* Timeline */
  .oj-timeline { padding: 6rem 0; background: #0f1614; }
  .oj-timeline-inner { max-width: 1080px; margin: 0 auto; padding: 0 2rem; }
  .oj-timeline .section-heading { margin-top: 0.75rem; margin-bottom: 3rem; }

  .oj-milestones {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
  }
  .oj-milestones::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 56px;
    width: 1px;
    background: linear-gradient(180deg, rgba(13,147,115,0.4) 0%, rgba(13,147,115,0.15) 100%);
  }

  .oj-milestone {
    background: #0a0f0e;
    border: 1px solid #1e2d28;
    border-radius: 20px;
    padding: 2rem 2.25rem;
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.75rem;
    align-items: start;
    position: relative;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .oj-milestone:hover {
    border-color: rgba(13,147,115,0.35);
    transform: translateY(-2px);
  }
  .oj-year {
    font-family: 'Sora', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #0d9373;
    background: rgba(13,147,115,0.08);
    border: 1px solid rgba(13,147,115,0.25);
    border-radius: 12px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.02em;
    position: relative;
    z-index: 1;
  }
  .oj-body { min-width: 0; }
  .oj-phase {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #0d9373;
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .oj-mile-title {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 700;
    color: white;
    margin: 0 0 0.625rem;
    letter-spacing: -0.02em;
  }
  .oj-body p {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: #8aa09a;
    line-height: 1.75;
    margin: 0;
    max-width: 640px;
  }

  /* Split */
  .oj-split { padding: 7rem 0; background: #0a0f0e; }
  .oj-split-inner { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .oj-split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .oj-split p {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: #8aa09a;
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }

  .oj-split-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 4.5rem;
  }
  .oj-split-card {
    background: #0f1614;
    border: 1px solid #1e2d28;
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.25rem;
    align-items: start;
    transition: border-color 0.3s ease;
  }
  .oj-split-card.is-primary {
    background: linear-gradient(135deg, rgba(13,147,115,0.08) 0%, #0f1614 60%);
    border-color: rgba(13,147,115,0.35);
  }
  .oj-split-mark {
    font-family: 'Sora', sans-serif;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #0d9373;
    background: rgba(13,147,115,0.1);
    border: 1px solid rgba(13,147,115,0.25);
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.04em;
  }
  .oj-split-body { display: flex; flex-direction: column; gap: 0.5rem; }
  .oj-split-body strong {
    font-family: 'Sora', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: white;
    letter-spacing: -0.01em;
  }
  .oj-split-body span {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    color: #8aa09a;
    line-height: 1.65;
  }
  .oj-split-body a {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #0d9373;
    text-decoration: none;
    align-self: flex-start;
    margin-top: 0.25rem;
    border-bottom: 1px solid rgba(13,147,115,0.35);
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .oj-split-body a:hover { color: #12b389; border-color: #12b389; }

  /* Team */
  .oj-team { padding: 7rem 0; background: #0f1614; }
  .oj-team-inner { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .oj-team-copy {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.0625rem;
    color: #8aa09a;
    line-height: 1.75;
    margin: 1.25rem 0 2rem;
  }
  .oj-team-actions {
    display: flex;
    gap: 0.875rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .oj-split-grid { grid-template-columns: 1fr; }
    .oj-split-cards { margin-top: 0; }
  }
  @media (max-width: 640px) {
    .oj-milestone {
      padding: 1.75rem;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .oj-milestones::before { display: none; }
    .oj-year { width: 88px; }
    .oj-split-card { padding: 1.25rem 1.5rem; }
  }
</style>
</content>
</invoke>