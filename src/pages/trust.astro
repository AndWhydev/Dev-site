---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';

/**
 * Trust page, the page every serious buyer needs before signing. Concrete
 * facts (company registration, addresses, hours), how we work on security,
 * a plain summary of the IP clauses in our Master Services Agreement, and a
 * downloadable mutual NDA they can run past their lawyer before the first
 * commercial conversation.
 *
 * Nothing on this page is a claim about who we work with. Where it describes
 * our obligations, the Master Services Agreement is what binds us.
 */

const facts = [
  { label: 'Legal entity', value: 'AW Labs Pty Ltd', detail: 'Known as AWLabs. Sister company to All Webbed Up, our marketing business, which is run separately.' },
  { label: 'ABN', value: '32 698 684 105', detail: 'Australian Business Number, verifiable on abr.business.gov.au' },
  { label: 'Registered office', value: 'Floor 1, 43 Ware Street, Fairfield NSW 2165', detail: 'As recorded with ASIC' },
  { label: 'Business address', value: '1 Ramsay Rd, Five Dock NSW 2046', detail: 'Greater Sydney, Australia' },
  { label: 'Operating hours', value: 'Monday to Friday, 9am to 6pm Sydney time', detail: 'A real person reads every reply' },
  { label: 'Ownership', value: '100% Australian-owned', detail: 'No offshore parent. Delivery is Australian-led and remains managed and accountable through AW Labs in Sydney.' },
  { label: 'Insurance', value: 'Professional indemnity $1M per claim ($2M in total each year). Public liability $10M. Cyber $500,000 per claim ($1M in total).', detail: 'Underwritten by Lloyd’s via CFC. Certificate of Currency provided to procurement on request.' },
];

const ipClauses = [
  {
    title: 'Our own tools stay ours',
    body: 'Anything we bring to the engagement that already existed before the project starts, such as our internal libraries, methods and templates, stays ours. The contract calls these Background IP. You get a permanent licence to use them inside your product. Open source stays under its existing licence.',
  },
  {
    title: 'What we build for you is yours once it is paid for',
    body: 'You own what we build for you once it is paid for. Each part is assigned to you as it is paid for in full, and until then you can see and test the code while we build. After launch we may show non confidential screenshots in our portfolio unless you tell us not to.',
  },
  {
    title: 'We do not embed silent dependencies on us',
    body: 'No phone home telemetry to our infrastructure. No hard coded API keys that route through us. No "you can only deploy this if we host it" architecture. Nothing we build depends on us to keep running. Once your final payment is made, you can run it without us.',
  },
  {
    title: 'You receive the keys',
    body: 'Your hosting, domain, app store and payment accounts are set up in your name before launch, once the amounts due are paid. The full repository, final logins, accounts and deployment details are handed over after the final payment.',
  },
];

const security = [
  {
    pillar: 'Authentication',
    bullets: [
      'Multi factor sign in on our internal accounts and the systems that touch client data',
      'Single sign on (SSO) where the client provides an identity provider',
      'Session tokens rotated; refresh tokens revoked on suspicious activity',
    ],
  },
  {
    pillar: 'Authorisation',
    bullets: [
      'Least privilege by default: our people get access only to the projects they work on',
      'Access to client production data is kept to the people who need it',
      'Production changes are made deliberately, not from shared admin logins',
    ],
  },
  {
    pillar: 'Data handling',
    bullets: [
      'Production data stays in the production environment unless you agree to an export',
      'Personal information is redacted from logs that may capture user input',
      'Encryption at rest and in transit as standard practice',
    ],
  },
  {
    pillar: 'Code and dependencies',
    bullets: [
      'Security is tested during every build, including automated penetration testing before launch',
      'An independent penetration test by a specialist firm is your choice, and we can help you arrange it',
      'Dependencies and secrets are checked during the build; leaked credentials are rotated',
    ],
  },
  {
    pillar: 'If something goes wrong',
    bullets: [
      'Roll back first, investigate second',
      'We tell you without undue delay if an incident affects your data or service',
      'We review what happened and track the fixes to closure',
    ],
  },
];

const aiData = [
  {
    pillar: 'Where your data goes',
    bullets: [
      'We can host your data in Australian cloud regions',
      'If your data must stay in Australia, tell us before you sign and we write it into your Schedule of Work',
      'Unless the Schedule of Work says so, our cloud providers, tools and team may store or access data outside Australia',
    ],
  },
  {
    pillar: 'Model providers and training',
    bullets: [
      'We use business accounts and settings for AI tools, not consumer AI apps, for client work',
      'If you need a tool that does not train on your data, tell us before the Schedule of Work and we will agree it in writing',
      'Prompts, documents and embeddings are treated with the same care as the source data',
    ],
  },
  {
    pillar: 'AI in our delivery pipeline',
    bullets: [
      'Our developers use AI coding tools, and they review AI assisted work before it ships',
      'If your contract restricts AI tooling on your codebase, we agree the rules in writing before work starts',
      'We take reasonable care to keep secrets and production data out of prompts, and develop with test or masked data',
    ],
  },
  {
    pillar: 'Controls in the systems we build',
    bullets: [
      'Access control enforced at retrieval, so AI features only see what the user is allowed to see',
      'Logging of prompts, sources and outputs where your policy allows, for audit and incident review',
      'Evaluation sets and human review paths for high-stakes outputs, aligned with Australia\'s Guidance for AI Adoption',
    ],
  },
];

const compliance = [
  {
    label: 'Australian Privacy Principles',
    body: 'Engagements handling personal information of Australian individuals are designed to the Australian Privacy Principles (APPs) under the Privacy Act 1988. Whether your specific use case triggers APP entity status is a call for your privacy counsel. We build as though the Australian Privacy Principles apply.',
  },
  {
    label: 'Data residency',
    body: 'We can host your data in Australian cloud regions. If your data must stay in Australia, tell us before you sign and we write it into your Schedule of Work.',
  },
  {
    label: 'R&D Tax Incentive',
    body: 'Some software development may qualify. Whether yours does, and what it is worth, is a question for a registered R&D tax agent. Our accountants at Crescendo can advise; they are a separate practice and you engage them directly. We keep build records your tax agent can ask for.',
  },
  {
    label: 'European users',
    body: 'If you have European users, we can scope GDPR features into your build, such as data subject requests, consent management and deletion requests. Your lawyer confirms what applies to you.',
  },
];
---

<Layout
  title="Trust, Compliance & IP, AWLabs"
  description="Company registration, how IP is assigned to you on payment, how we work on security and AI, and a downloadable mutual NDA. What serious buyers should read before briefing us."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="trust-hero">
      <div class="trust-hero-inner">
        <div class="reveal">
          <span class="section-label">Trust &amp; compliance</span>
          <h1 class="trust-title">
            Read this before you brief us.
          </h1>
          <p class="trust-lead">
            This page summarises how we work. Where it describes our obligations, the Master Services Agreement is what binds us. We have written it down so you do not have to ask, and so your legal and security people can check us before the first commercial conversation.
          </p>
          <div class="trust-actions">
            <a href="/docs/mutual-nda.pdf" class="btn-primary" download>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download mutual NDA
            </a>
            <a href="/MSA" class="btn-outline">
              Read our Master Services Agreement
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Company facts -->
    <section class="trust-facts">
      <div class="trust-facts-inner">
        <div class="reveal" style="max-width: 720px;">
          <span class="section-label">Company on the record</span>
          <h2 class="section-heading">The verifiable facts.</h2>
          <p class="section-subheading">
            The company details below can be checked on public record (ASIC and the ABR). The insurance certificate is available to procurement on request.
          </p>
        </div>

        <div class="facts-grid">
          {facts.map((f) => (
            <div class="fact-card reveal">
              <div class="fact-label">{f.label}</div>
              <div class="fact-value">{f.value}</div>
              <div class="fact-detail">{f.detail}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- IP transfer -->
    <section class="trust-ip">
      <div class="trust-ip-inner">
        <div class="reveal" style="max-width: 760px;">
          <span class="section-label">Intellectual property</span>
          <h2 class="section-heading">You own what we build for you once it is paid for.</h2>
          <p class="section-subheading">
            A plain English summary of the IP clauses in our Master Services Agreement. Assigned to you on payment. Where this summary and the agreement differ, the agreement applies.
          </p>
        </div>

        <div class="ip-list">
          {ipClauses.map((clause) => (
            <article class="ip-card reveal">
              <h3>{clause.title}</h3>
              <p>{clause.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Security -->
    <section class="trust-security">
      <div class="trust-security-inner">
        <div class="reveal" style="max-width: 760px;">
          <span class="section-label">Security posture</span>
          <h2 class="section-heading">How we work on security.</h2>
          <p class="section-subheading">
            This page summarises how we work. Where it describes our obligations, the Master Services Agreement is what binds us. We build security to fit your risk: not gold plated, and not left exposed. An independent penetration test by a specialist firm is your choice, and we can help you arrange it.
          </p>
        </div>

        <div class="sec-grid">
          {security.map((s) => (
            <div class="sec-card reveal">
              <h3 class="sec-card-pillar">{s.pillar}</h3>
              <ul>
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- AI and your data -->
    <section class="trust-ai" id="ai-and-your-data">
      <div class="trust-security-inner">
        <div class="reveal" style="max-width: 760px;">
          <span class="section-label">AI and your data</span>
          <h2 class="section-heading">How we handle your data around AI.</h2>
          <p class="section-subheading">
            The questions procurement asks about AI: where data is processed, whether it trains anyone's model, and how AI is used in our own delivery. See also our guide to <a href="/guides/data-residency-vs-data-sovereignty">data residency vs data sovereignty</a>.
          </p>
        </div>

        <div class="sec-grid">
          {aiData.map((s) => (
            <div class="sec-card reveal">
              <h3 class="sec-card-pillar">{s.pillar}</h3>
              <ul>
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compliance -->
    <section class="trust-compliance">
      <div class="trust-compliance-inner">
        <div class="reveal" style="max-width: 760px;">
          <span class="section-label">Compliance position</span>
          <h2 class="section-heading">How we treat Australian and adjacent regulation.</h2>
        </div>

        <div class="comp-list">
          {compliance.map((c) => (
            <article class="comp-card reveal">
              <h3>{c.label}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="trust-disclaimer">
      <div class="trust-disclaimer-inner">
        <div class="reveal">
          <p>
            <strong>An honest note.</strong> Our founder has been shipping software since 2019 and running All Webbed Up as a Sydney marketing and development agency since 2021. AWLabs itself launched in mid 2026 as a new company, a partnership with a group of exceptional developers and founders. We have deliberately not stamped this site with certifications we have not earned or badges we cannot produce on request. If something on this page matters to your procurement process and we have not addressed it, ask us directly at <a href="mailto:admin@awlabs.com.au">admin@awlabs.com.au</a>, we will tell you yes, no or "not yet" without dressing it up.
          </p>
        </div>
      </div>
    </section>

    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  /* Hero */
  .trust-hero {
    padding: 10rem 0 5rem;
    background: #0a0f0e;
    position: relative;
    overflow: hidden;
  }
  .trust-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 30%, rgba(13,147,115,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .trust-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }
  .trust-title {
    font-family: 'Sora', sans-serif;
    /* Min lowered from 2.5rem → 1.75rem so it fits comfortably on
       360 to 414px phones without clipping. Tablet/desktop unaffected. */
    font-size: clamp(1.75rem, 6.5vw, 4.5rem);
    font-weight: 800;
    color: white;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem;
    max-width: 760px;
    overflow-wrap: break-word;
  }
  .trust-lead {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: #8aa09a;
    line-height: 1.7;
    max-width: 760px;
    margin: 0 0 2rem;
  }
  .trust-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .trust-actions .btn-primary, .trust-actions .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Sections */
  .trust-facts, .trust-ip, .trust-security, .trust-ai, .trust-compliance, .trust-disclaimer {
    padding: 6.5rem 0;
  }
  .trust-facts { background: #0f1614; }
  .trust-ip { background: #0a0f0e; }
  .trust-security { background: #0f1614; }
  .trust-ai { background: #0a0f0e; }
  .trust-ai .section-subheading a { color: #19b58f; }
  .trust-compliance { background: #0f1614; }
  .trust-disclaimer { background: #0a0f0e; padding: 4.5rem 0; }

  .trust-facts-inner, .trust-ip-inner, .trust-security-inner, .trust-compliance-inner, .trust-disclaimer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Facts */
  .facts-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .fact-card {
    background: #0a0f0e;
    border: 1px solid #1e2d28;
    border-radius: 14px;
    padding: 1.5rem 1.75rem;
    transition: border-color 0.3s ease;
  }
  .fact-card:hover { border-color: rgba(13,147,115,0.3); }
  .fact-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4a6359;
    margin-bottom: 0.625rem;
  }
  .fact-value {
    font-family: 'Sora', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: white;
    letter-spacing: -0.005em;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    /* Allow address strings ("1 Ramsay Rd, Five Dock NSW 2046") and
       wide entity names to wrap inside the card on narrow screens. */
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .fact-detail {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    color: #4a6359;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  /* IP */
  .ip-list {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .ip-card {
    background: #0f1614;
    border: 1px solid #1e2d28;
    border-radius: 14px;
    padding: 1.75rem 2rem;
    transition: border-color 0.3s ease;
  }
  .ip-card:hover { border-color: rgba(13,147,115,0.3); }
  .ip-card h3 {
    font-family: 'Sora', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: white;
    margin: 0 0 0.875rem;
  }
  .ip-card p {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    color: #8aa09a;
    line-height: 1.7;
    margin: 0;
  }

  /* Security */
  .sec-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .sec-card {
    background: #0a0f0e;
    border: 1px solid #1e2d28;
    border-radius: 14px;
    padding: 1.5rem 1.75rem;
  }
  .sec-card-pillar {
    font-family: 'Sora', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #0d9373;
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #1e2d28;
    letter-spacing: 0.02em;
  }
  .sec-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .sec-card li {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: #8aa09a;
    line-height: 1.55;
    padding-left: 1.125rem;
    position: relative;
  }
  .sec-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    background: #0d9373;
    border-radius: 50%;
  }

  /* Compliance */
  .comp-list {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .comp-card {
    background: #0f1614;
    border: 1px solid #1e2d28;
    border-radius: 14px;
    padding: 1.75rem 2rem;
  }
  .comp-card h3 {
    font-family: 'Sora', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: white;
    margin: 0 0 0.75rem;
  }
  .comp-card p {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    color: #8aa09a;
    line-height: 1.7;
    margin: 0;
  }

  /* Disclaimer */
  .trust-disclaimer p {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: #8aa09a;
    line-height: 1.75;
    margin: 0;
    max-width: 880px;
    background: rgba(13,147,115,0.04);
    border: 1px solid rgba(13,147,115,0.15);
    border-left: 3px solid #0d9373;
    padding: 1.75rem 2rem;
    border-radius: 0 12px 12px 0;
  }
  .trust-disclaimer p strong { color: white; font-weight: 700; }
  .trust-disclaimer p a { color: #0d9373; text-decoration: none; border-bottom: 1px solid rgba(13,147,115,0.4); }
  .trust-disclaimer p a:hover { border-color: #0d9373; }

  /* Responsive */
  @media (max-width: 1024px) {
    .facts-grid { grid-template-columns: repeat(2, 1fr); }
    .ip-list, .sec-grid, .comp-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .trust-hero { padding: 8rem 0 4rem; }
    .trust-facts, .trust-ip, .trust-security, .trust-compliance { padding: 4rem 0; }
    .trust-disclaimer { padding: 3rem 0; }
    .trust-facts-inner, .trust-ip-inner, .trust-security-inner, .trust-compliance-inner, .trust-disclaimer-inner { padding: 0 1.25rem; }
    .facts-grid { grid-template-columns: 1fr; }
    .ip-card, .sec-card, .comp-card { padding: 1.5rem 1.5rem; }
  }
</style>
