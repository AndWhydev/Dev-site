    {
      step: "06",
      title: "Launch and Handover",
      duration: "Final week",
      description: "We deploy to your cloud account in an Australian region by default, monitor closely through launch, and hand over documentation, runbooks and a runtime upgrade schedule. Ongoing support is available under a maintenance retainer.",
    },
