      term: 'AI Receptionist',
      definition: 'A voice agent set up to answer a business\'s inbound calls: greeting callers, answering common questions, taking bookings and messages, and transferring calls to staff.',
    },
    {
      term: 'Warm Transfer',
      definition: 'A handover where the agent passes the call to a person along with a short summary, so the caller does not have to start again.',
    },
    {
      term: 'Latency',
      definition: 'The delay between a caller finishing a sentence and the agent starting to reply. On the phone, delays beyond a second or two feel unnatural, so it is measured on every call.',
    },
