    notRightFor: [
      "You need an independent report for a dispute, sale or investment and no further development, where a standalone code audit fits better",
      "The current team is responsive and capable and the issue is scope or budget, which is better solved by talking to them first",
      "An off the shelf product now does what the custom build was meant to do, in which case switching may be cheaper than rescuing",
      "You need us to pursue the previous developer for code or money, which is a legal matter for a lawyer, not a developer",
      "The software is built on a stack we don't work in, which we will tell you at the Development Consult or during the audit",
    ],
  },
  definitions: [
    {
      term: "Project takeover",
      definition: "Transferring responsibility for an existing software system from one developer or agency to another, including the code, the accounts it runs on and the knowledge of how it is built and deployed.",
    },
    {
      term: "Stabilisation",
      definition: "The first phase of a rescue, which makes the system safe to run and change before new features are added: backups that restore, monitoring, urgent security fixes and a deployment process anyone can repeat.",
    },
    {
      term: "Access map",
      definition: "A list of every account and service the software depends on, who owns each one, who can log in, and where the billing sits. It shows at a glance which accounts are still held by a former developer.",
    },
    {
      term: "Run book",
      definition: "Step by step instructions for building, deploying, backing up, restoring and troubleshooting a system, written so that a new engineer can operate it without the original author.",
    },
    {
      term: "App transfer",
      definition: "Moving an app from one Apple or Google developer account to another. The app keeps its store listing, ratings and reviews, but the current account holder must start or approve the transfer.",
    },
    {
      term: "Copyright assignment",
      definition: "A written transfer of ownership of copyright, for example in source code, from its author to another party. Without one, a contractor who wrote commissioned code may still own the copyright.",
    },
  ],
  relatedServices: [
    { title: "Dave's story: a platform brought back to life", href: "/client-stories#story-dave" },
