  process: [
    {
      step: "01",
      title: "Development Consult",
      description: "A 15 minute phone call, or a Zoom with Andy, to hear what happened, what the software is meant to do and what is at stake. We tell you on the call whether a takeover looks feasible and what we would need to see next. An NDA can be signed before you share anything sensitive.",
    },
    {
      step: "02",
      title: "Secure Access and Accounts",
      description: "We work through the account checklist with you: repository, hosting, domains and DNS, app store accounts, database and backups, API keys and third party billing. We list what you hold, what the previous developer holds, and the exact wording of what to request from them.",
    },
    {
      step: "03",
      title: "Discovery Audit of the Codebase",
      description: "Senior engineers read the code, scan it, and attempt a clean build and deployment in an environment you control. The Discovery Audit is a paid, fixed fee step, credited in full against the work that follows, and it ends with a written assessment and a fix, finish or rebuild recommendation for each part.",
    },
    {
      step: "04",
      title: "Schedule of Work",
      description: "You receive a fixed price Schedule of Work with three options: The Minimum, which stabilises the system and makes it safe to run; The Recommended, which also finishes the features that matter most; and The Complete, which finishes the full original scope with the fragile parts rebuilt. You choose.",
    },
    {
      step: "05",
      title: "Stabilise, Then Finish",
      description: "Stabilisation comes first: backups, monitoring, security fixes and a deployment anyone can repeat. Then the agreed features are fixed or finished. Senior engineers lead the work and review every change, and you get progress updates every Tuesday and Friday, Sydney time.",
    },
    {
      step: "06",
      title: "Launch, Warranty and Care Plan",
      description: "We release to production or the app stores, hand over the updated documentation and assign the code to you as each part is paid for. A 30 day warranty covers defects in our work after launch, and a month to month Care Plan can keep the system patched and supported from there.",
    },
  ],
  industries: [
    "Construction & Trades",
    "Startups & Founders",
    "Professional Services",
    "Healthcare & Allied Health",
