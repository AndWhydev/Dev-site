---
import ServicePageLayout from '../../layouts/ServicePageLayout.astro';

const data = {
  metaTitle: 'Custom Software Development Australia | AWLabs',
  metaDescription: 'Custom software development in Sydney for organisations across Australia: bespoke web and mobile apps built to your workflows, one fixed price after a Discovery Audit.',
  category: 'Development',
  heroHeadline: 'Custom Software Built to Your Exact Specifications',
  heroTagline: 'Custom software development from Sydney for organisations across Australia. Stop retrofitting off-the-shelf software to workflows it was never designed for.',
  description: [
    'Off-the-shelf platforms are engineered for the broadest possible market, not your industry, not your compliance obligations, and certainly not the edge cases that define how your business actually operates. When you spend months configuring a SaaS product and still need to bolt on integrations, spreadsheets and manual workarounds, you have already paid more than a custom application would have cost. We design and build software that reflects your exact operational model, from data structures to user roles to approval workflows.',
    'Our custom application practice spans full-stack web development, native and cross-platform mobile, and backend systems that connect into existing enterprise infrastructure. Every build has one fixed price for an agreed scope, set out in a Schedule of Work. Every application is load tested, security tested and documented, then handed over with source code, deployment runbooks and enough knowledge for your internal team to run it independently.',
  ],
  benefits: [
    {
      icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
