    {
      step: '06',
      title: 'Deployment & Handover',
      duration: 'Final week',
      description: 'Production deployment via your CI/CD pipeline with zero-downtime strategies (blue-green or rolling). Full handover includes source code, infrastructure-as-code, runbooks, user documentation and a live knowledge-transfer session with your engineering team.',
    },
