  definitions: [
    {
      term: 'CRM Integration',
      definition: 'Connecting a CRM to other systems through APIs and webhooks so contacts, deals, activities and related records stay consistent across them.',
    },
    {
      term: 'Deduplication',
      definition: 'Detecting and merging records that represent the same person or company, using matching rules such as email, phone or ABN.',
    },
    {
      term: 'Lead Routing',
      definition: 'Rules that assign a new lead to the right owner or team automatically, based on territory, service, source or workload.',
    },
    {
      term: 'Webhook',
      definition: 'A message one system sends to another the moment something happens, such as a new lead, so the receiving system does not have to keep asking.',
    },
    {
      term: 'API Rate Limit',
      definition: 'The maximum number of requests a platform accepts in a time window. Integrations are designed to stay under it with batching, caching and queues.',
    },
