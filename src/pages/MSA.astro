---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import msaBody from '../data/msa-body.html?raw';

const lastReviewed = '11 September 2026';

const clauses = [
  { num: '1', title: 'Operative Framework' },
  { num: '2', title: 'Services and Service Standard' },
  { num: '3', title: 'Client Obligations and Dependencies' },
  { num: '4', title: 'Infrastructure, Accounts, Access and Security' },
  { num: '5', title: 'Fees, Invoicing and Payment' },
  { num: '6', title: "Director's Guarantee" },
  { num: '7', title: 'Scope Control and Variations' },
  { num: '8', title: 'Development, Testing, Acceptance and Handover' },
  { num: '9', title: 'Warranty and Post-Handover Support' },
  { num: '10', title: 'Suspension' },
  { num: '11', title: 'Intellectual Property' },
  { num: '12', title: 'AI-Assisted Services' },
  { num: '13', title: 'Confidentiality' },
  { num: '14', title: 'Privacy, Data and Security' },
  { num: '15', title: 'Independent Professional Advisers' },
  { num: '16', title: 'Marketing, Advertising and Content Services' },
  { num: '17', title: 'Ongoing, Hosting, Maintenance and Care Services' },
  { num: '18', title: 'Warranties and Australian Consumer Law' },
  { num: '19', title: 'Limitation of Liability' },
  { num: '20', title: 'Term and Termination' },
  { num: '21', title: 'Dispute Resolution' },
  { num: '22', title: 'Relationship of Parties' },
  { num: '23', title: 'Publicity and Use of Names' },
  { num: '24', title: 'Notices' },
  { num: '25', title: 'Assignment and Corporate Changes' },
  { num: '26', title: 'General' },
  { num: '27', title: 'Force Majeure' },
  { num: '28', title: 'Governing Law and Jurisdiction' },
  { num: '29', title: 'Definitions and Interpretation' },
];
---

<Layout
  title="Master Services Agreement, All Webbed Labs"
  description="AW Labs Pty Ltd's Master Services Agreement — the umbrella terms that govern each Schedule of Work or Care Plan entered into with our clients."
  noindex={true}
>
  <Header />
  <main>
    <section class="policy-section">
      <div class="policy-inner">
        <div class="policy-header reveal">
          <span class="section-label">Legal</span>
          <h1>Master Services Agreement</h1>
          <p class="policy-meta">Version dated {lastReviewed} · AW Labs Pty Ltd · ABN 32 698 684 105</p>

          <div class="policy-actions">
            <a
              href="/client-pack/msa.pdf"
              class="btn-download"
              target="_blank"
              rel="noopener"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download PDF
            </a>
          </div>
        </div>

        <div class="policy-content">
          <p class="policy-lead">
            The full Master Services Agreement is reproduced on this page for your review. You
            are not signing anything by opening the page — the MSA is executed only when you are
            ready to proceed with a project, alongside a Schedule of Work for the specific work.
            Take as long as you need, share it with your advisers, and email
            <a href="mailto:admin@awlabs.com.au">admin@awlabs.com.au</a> if you would like to
            walk through any clause with us.
          </p>

          <details class="msa-toc">
            <summary>Contents · 29 clauses</summary>
            <ol class="msa-toc-list">
              {clauses.map((c) => (
                <li>
                  <a href={`#clause-${c.num}`}>
                    <span class="msa-toc-num">{c.num}</span>
                    <span class="msa-toc-title">{c.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>

          <div class="msa-body" set:html={msaBody} />

          <hr class="policy-rule" />

          <p class="policy-foot">
            This page reproduces the full text of the Master Services Agreement dated
            {lastReviewed}. In the event of any inconsistency between this page and the signed
            PDF above, the signed PDF prevails.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .policy-section { padding: 9rem 0 6rem; background: #0a0f0e; min-height: 80vh; }
  .policy-inner { max-width: 860px; margin: 0 auto; padding: 0 2rem; }
  .policy-header { margin-bottom: 3rem; }
  .policy-header h1 {
    font-family: 'Sora', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: white;
    margin: 0.75rem 0 0.5rem;
    letter-spacing: -0.015em;
  }
  .policy-meta {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: #6b8478;
    margin: 0 0 1.5rem;
  }

  .policy-actions { margin-top: 1.25rem; }
  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: white;
    background: #0d9373;
    text-decoration: none;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: background 0.2s ease, transform 0.2s ease, gap 0.2s ease;
  }
  .btn-download:hover { background: #14b58e; gap: 0.75rem; }
  .btn-download svg { flex-shrink: 0; }

  .policy-content { font-family: 'DM Sans', sans-serif; }
  .policy-content h2 {
    font-family: 'Sora', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin: 3rem 0 1rem;
    letter-spacing: -0.01em;
    scroll-margin-top: 6rem;
  }
  .policy-content h3 {
    font-family: 'Sora', sans-serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #e1eee9;
    margin: 2rem 0 0.75rem;
    letter-spacing: -0.005em;
    scroll-margin-top: 6rem;
  }
  .policy-content p,
  .policy-content li {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9625rem;
    color: #cde0da;
    line-height: 1.75;
  }
  .policy-content p { margin: 0 0 1rem; }
  .policy-content strong { color: white; font-weight: 600; }
  .policy-content a {
    color: #0d9373;
    text-decoration: none;
    border-bottom: 1px solid rgba(13, 147, 115, 0.4);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .policy-content a:hover { border-color: #0d9373; color: #14b58e; }

  .policy-lead {
    font-size: 1.0625rem !important;
    line-height: 1.7 !important;
    color: #e1eee9 !important;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid #0d9373;
    background: rgba(13, 147, 115, 0.06);
    margin: 0 0 2rem 0 !important;
    border-radius: 0 6px 6px 0;
  }

  /* Table of contents */
  .msa-toc {
    background: #0f1614;
    border: 1px solid rgba(30, 45, 40, 0.7);
    border-radius: 12px;
    padding: 1rem 1.375rem;
    margin: 0 0 3rem;
  }
  .msa-toc summary {
    cursor: pointer;
    font-family: 'Sora', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: white;
    letter-spacing: -0.005em;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .msa-toc summary::-webkit-details-marker { display: none; }
  .msa-toc summary::after {
    content: '+';
    color: #0d9373;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 400;
    transition: transform 0.2s ease;
  }
  .msa-toc[open] summary::after { content: '−'; }
  .msa-toc-list {
    list-style: none;
    padding: 1rem 0 0.25rem;
    margin: 1rem 0 0;
    border-top: 1px solid rgba(30, 45, 40, 0.7);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.25rem 1rem;
  }
  .msa-toc-list li { margin: 0; }
  .msa-toc-list a {
    display: flex;
    gap: 0.75rem;
    padding: 0.4rem 0;
    color: #8aa09a;
    border-bottom: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .msa-toc-list a:hover { color: #0d9373; }
  .msa-toc-num {
    flex-shrink: 0;
    width: 1.75rem;
    color: #0d9373;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* MSA body */
  .msa-body :global(section) {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .msa-body :global(.msa-intro),
  .msa-body :global(.msa-parties-block),
  .msa-body :global(.msa-recitals) {
    padding-bottom: 2rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Parties block */
  .msa-body :global(.msa-party) {
    background: #0f1614;
    border: 1px solid rgba(30, 45, 40, 0.6);
    border-radius: 12px;
    padding: 1.25rem 1.375rem;
    margin-bottom: 0.75rem;
  }
  .msa-body :global(.msa-party-label) {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0d9373;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .msa-body :global(.msa-party strong) {
    display: block;
    font-family: 'Sora', sans-serif;
    font-size: 1.0625rem;
    color: white;
    font-weight: 700;
    letter-spacing: -0.005em;
    margin-bottom: 0.5rem;
  }
  .msa-body :global(.msa-party p) {
    font-size: 0.875rem !important;
    color: #8aa09a !important;
    margin: 0 !important;
    line-height: 1.6 !important;
  }

  /* Recitals list */
  .msa-body :global(.msa-recitals-list) {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.5rem;
  }
  .msa-body :global(.msa-recitals-list > li) {
    position: relative;
    padding-left: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .msa-body :global(.msa-recitals-list > li::before) {
    content: attr(data-letter);
    position: absolute;
    left: 0;
    top: 0;
    color: #0d9373;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9625rem;
  }
  .msa-body :global(.msa-recitals-list > li > p) { margin: 0; }
  .msa-body :global(.msa-agree) {
    font-weight: 600 !important;
    color: white !important;
    margin-top: 1.5rem !important;
  }

  /* Alpha lists (a)(b)(c) */
  .msa-body :global(.msa-alpha) {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1.25rem;
  }
  .msa-body :global(.msa-alpha > li) {
    position: relative;
    padding-left: 2.25rem;
    margin-bottom: 1rem;
  }
  .msa-body :global(.msa-alpha > li::before) {
    content: attr(data-letter);
    position: absolute;
    left: 0;
    top: 0;
    color: #0d9373;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    font-variant-numeric: tabular-nums;
    font-size: 0.9375rem;
  }
  .msa-body :global(.msa-alpha > li > p) { margin: 0 0 0.5rem; }

  /* Roman lists inside alpha */
  .msa-body :global(.msa-roman) {
    list-style: lower-roman;
    padding-left: 1.75rem;
    margin: 0.5rem 0 0.5rem;
  }
  .msa-body :global(.msa-roman > li) {
    margin-bottom: 0.4rem;
    padding-left: 0.4rem;
  }
  .msa-body :global(.msa-roman > li::marker) {
    color: #6b8478;
    font-variant-numeric: tabular-nums;
  }

  /* Definitions table */
  .msa-body :global(.msa-defs) {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0.6rem 1.5rem;
    margin: 1rem 0 1.5rem;
    padding: 1.25rem 1.5rem;
    background: #0f1614;
    border: 1px solid rgba(30, 45, 40, 0.6);
    border-radius: 12px;
  }
  .msa-body :global(.msa-defs dt) {
    color: white;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
  }
  .msa-body :global(.msa-defs dd) {
    color: #cde0da;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Execution note */
  .msa-body :global(.msa-execution) {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: rgba(13, 147, 115, 0.04);
    border-left: 3px solid rgba(13, 147, 115, 0.4);
    border-radius: 0 8px 8px 0;
  }
  .msa-body :global(.msa-execution h2) { margin-top: 0.25rem; }
  .msa-body :global(.msa-execution em) { font-style: italic; }

  .policy-rule {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 3rem 0 1.5rem 0;
  }
  .policy-foot {
    font-size: 0.875rem !important;
    color: rgba(205, 224, 218, 0.65) !important;
    font-style: italic;
  }

  @media (max-width: 720px) {
    .msa-toc-list { grid-template-columns: 1fr; }
    .msa-body :global(.msa-defs) {
      grid-template-columns: 1fr;
      gap: 0.15rem 0;
      padding: 1rem 1.125rem;
    }
    .msa-body :global(.msa-defs dt) { margin-top: 0.5rem; }
    .msa-body :global(.msa-defs dt:first-child) { margin-top: 0; }
  }
</style>
