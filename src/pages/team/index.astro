---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTABanner from '../../components/CTABanner.astro';
import TeamSection from '../../components/TeamSection.astro';

const pageTitle = 'Our Team: Engineers and Specialists | AWLabs';
const pageDescription =
  'Meet the AWLabs team: the developers who build your product, and the lawyers and accountants we work with on every build.';

const siteUrl = 'https://www.awlabs.com.au';
const org = { '@id': `${siteUrl}/#organization` };

// Our own staff. Outside firms and consultants are not marked up as
// employees. Facts here must match TeamSection.astro.
const people = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/team/andy-taleb#person`,
    name: 'Andy Taleb',
    jobTitle: 'Director',
    url: `${siteUrl}/team/andy-taleb`,
    image: `${siteUrl}/team/andy-taleb.webp`,
    worksFor: org,
    sameAs: ['https://www.linkedin.com/in/andytaleb/'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/team#sam-trinder`,
    name: 'Sam Trinder',
    jobTitle: 'Lead Developer',
    image: `${siteUrl}/team/sam-trinder.webp`,
    worksFor: org,
    sameAs: ['https://www.linkedin.com/in/sam-trinder-4b5680377/'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/team#nicole-jones`,
    name: 'Nicole Jones',
    jobTitle: 'Junior Developer & Admin',
    image: `${siteUrl}/team/nicole-jones.webp`,
    worksFor: org,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/team#lucy-cassidy`,
    name: 'Lucy Cassidy',
    jobTitle: 'Developer in Training',
    image: `${siteUrl}/team/lucy.webp`,
    worksFor: org,
  },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.awlabs.com.au' },
    { '@type': 'ListItem', position: 2, name: 'Team', item: 'https://www.awlabs.com.au/team' },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} extraSchema={[breadcrumb, ...people]}>
  <Header />
  <main>
    <section class="team-hero">
      <div class="team-hero-inner reveal">
        <span class="section-label">Our team</span>
        <h1 class="team-hero-title">
          The people behind<br />
          <span class="gradient-text">your build.</span>
        </h1>
        <p class="team-hero-lead">
          Our developers build your product. Our lawyers and accountants work with us on every build. They are separate practices with their own licences, and you engage them directly. We guide you to them.
        </p>
      </div>
    </section>

    <TeamSection />
    <CTABanner />
  </main>
  <Footer />
</Layout>

<style>
  .team-hero {
    background: #0a0f0e;
    padding: 10rem 0 2rem;
  }
  .team-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
  }
  .team-hero-title {
    font-family: 'Sora', sans-serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: white;
    margin: 1rem 0 1.5rem;
  }
  .team-hero-lead {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.125rem;
    line-height: 1.7;
    color: #cde0da;
    margin: 0 auto;
    max-width: 640px;
  }
  @media (max-width: 640px) {
    .team-hero { padding: 8rem 0 1rem; }
    .team-hero-inner { padding: 0 1rem; }
  }
</style>
