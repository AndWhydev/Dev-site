{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?aibusinesssolutions\\.au"
        }
      ],
      "destination": "https://www.awlabs.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/mutual-NDA",
      "destination": "/NDA",
      "permanent": false
    },
    {
      "source": "/mutual-nda",
      "destination": "/NDA",
      "permanent": false
    },
    {
      "source": "/nda",
      "destination": "/NDA",
      "permanent": false
    },
    {
      "source": "/msa",
      "destination": "/MSA",
      "permanent": false
    },
    {
      "source": "/master-services-agreement",
      "destination": "/MSA",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/services/nft-marketplace",
      "destination": "/services/blockchain-development",
      "permanent": true
    },
    {
      "source": "/services/defi-platform",
      "destination": "/services/blockchain-development",
      "permanent": true
    },
    {
      "source": "/docs/mutual-nda.pdf",
      "destination": "/client-pack/mutual-nda.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/:all*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|woff|ttf|otf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(mp4|webm|mov)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/client-pack/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/|/.*)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-src 'self' https://golf-app-demo.vercel.app https://links.awlabs.com.au https://*.leadconnectorhq.com https://*.msgsndr.com;"
        }
      ]
    }
  ]
}
